{
  "name": "@dp/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-messages.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-messages.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "intl-messageformat": "^12.1.3"
  },
  "devDependencies": {
    "@dp/config": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3"
  }
}