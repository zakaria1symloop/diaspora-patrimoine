{
  "name": "@dp/api",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --enable-source-maps --watch-path=dist --env-file-if-exists=.env dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "install:run": "node --env-file-if-exists=.env dist/install/install.js",
    "ops": "node --env-file-if-exists=.env dist/install/ops.js",
    "demo": "node --env-file-if-exists=.env dist/install/demo.js",
    "demo:remove": "node --env-file-if-exists=.env dist/install/demo-remove.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:install": "node scripts/db.mjs init",
    "db:start": "node scripts/db.mjs start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@dp/contracts": "workspace:*",
    "@dp/domain": "workspace:*",
    "@dp/i18n": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "countries-and-timezones": "^3.10.0",
    "country-to-currency": "^3.0.1",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.13.14",
    "pdfkit": "0.17.2",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "uuid": "^14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dp/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.6",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
