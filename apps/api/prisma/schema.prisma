  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)

  event       Event     @relation("EventPartner_event", fields: [eventId], references: [id], onDelete: Cascade)
  promoter    Promoter? @relation("EventPartner_promoter", fields: [promoterId], references: [id], onDelete: Restrict)
  bank        Bank?     @relation("EventPartner_bank", fields: [bankId], references: [id], onDelete: Restrict)
  partner     Partner?  @relation("EventPartner_partner", fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("EventPartner_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("EventPartner_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([promoterId])
  @@index([bankId])
  @@index([partnerId])
  @@index([createdById])
  @@index([updatedById])
  @@map("event_partners")
}

/// 01-domaine/05 § 3.3 — EventRegistration ⟳
model EventRegistration {
  id              String             @id @db.Uuid
