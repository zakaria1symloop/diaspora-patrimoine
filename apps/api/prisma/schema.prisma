/// 01-domaine/03 § 1 — Program ⌫ ⟳
model Program {
  id                        String                 @id @db.Uuid
  promoterId                String                 @map("promoter_id") @db.Uuid
  name                      String                 @db.VarChar(120)
  slug                      String                 @db.VarChar(80)
  tagline                   String?                @db.VarChar(160)
  description               String?                @db.VarChar(5000)
  standing                  Standing
  countryCode               String                 @map("country_code") @db.Char(2)
  regionId                  String                 @map("region_id") @db.Uuid
  cityId                    String?                @map("city_id") @db.Uuid
  /// Internal, never published (TRV-045)
  addressLine               String?                @map("address_line") @db.VarChar(200)
  latitude                  Decimal?               @db.Decimal(9, 6)
  longitude                 Decimal?               @db.Decimal(9, 6)
  deliveryStatus            DeliveryStatus         @map("delivery_status")
  deliveryDate              DateTime?              @map("delivery_date") @db.Date
  deliveryDatePrecision     DatePrecision          @default(QUARTER) @map("delivery_date_precision")
  totalUnits                Int?                   @map("total_units")
  amenities                 String[]               @default([]) @db.VarChar(40)
  guarantees                String?                @db.VarChar(600)
  highlightLabel            String?                @map("highlight_label") @db.VarChar(40)
  highlightUntil            DateTime?              @map("highlight_until") @db.Date
  publication               PublicationStatus      @default(DRAFT)
  publishedAt               DateTime?              @map("published_at") @db.Timestamptz(3)
  firstPublishedAt          DateTime?              @map("first_published_at") @db.Timestamptz(3)
  unpublishedBySuspensionAt DateTime?              @map("unpublished_by_suspension_at") @db.Timestamptz(3)
  seoTitle                  String?                @map("seo_title") @db.VarChar(70)
  seoDescription            String?                @map("seo_description") @db.VarChar(160)
  /// cache (MOD-014)
  lotsTotal                 Int                    @default(0) @map("lots_total")
  /// cache
  lotsAvailable             Int                    @default(0) @map("lots_available")
  /// cache
  lotsHeld                  Int                    @default(0) @map("lots_held")
  /// cache
  lotsSold                  Int                    @default(0) @map("lots_sold")
  /// cache
  listedPropertyCount       Int                    @default(0) @map("listed_property_count")
  /// cache
  lastSoldAt                DateTime?              @map("last_sold_at") @db.Timestamptz(3)
  /// cache
  priceFrom                 Decimal?               @map("price_from") @db.Decimal(14, 2)
  /// cache
  priceFromRef              Decimal?               @map("price_from_ref") @db.Decimal(14, 2)
  stockConfirmedAt          DateTime?              @map("stock_confirmed_at") @db.Timestamptz(3)
  stockConfirmedBy          String?                @map("stock_confirmed_by") @db.VarChar(160)
  submittedForReviewAt      DateTime?              @map("submitted_for_review_at") @db.Timestamptz(3)
  reviewedAt                DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  reviewedById              String?                @map("reviewed_by_id") @db.Uuid
  reviewNote                String?                @map("review_note") @db.VarChar(1000)
  createdById               String?                @map("created_by_id") @db.Uuid
  updatedById               String?                @map("updated_by_id") @db.Uuid
  deletedAt                 DateTime?              @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version                   Int                    @default(1)
  createdAt                 DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @map("updated_at") @db.Timestamptz(3)

  promoter                  Promoter               @relation("Program_promoter", fields: [promoterId], references: [id], onDelete: Restrict)
  country                   Country                @relation("Program_country", fields: [countryCode], references: [code], onDelete: Restrict)
  region                    Region                 @relation("Program_region", fields: [regionId], references: [id], onDelete: Restrict)
  city                      City?                  @relation("Program_city", fields: [cityId], references: [id], onDelete: Restrict)
  reviewedBy                User?                  @relation("Program_reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdBy                 User?                  @relation("Program_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 User?                  @relation("Program_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  properties                Property[]             @relation("Property_program")
  propertyPois              PropertyPoi[]          @relation("PropertyPoi_program")
  programUpdates            ProgramUpdate[]        @relation("ProgramUpdate_program")
  financingEligibilities    FinancingEligibility[] @relation("FinancingEligibility_program")
  leads                     Lead[]                 @relation("Lead_program")
  dossiers                  Dossier[]              @relation("Dossier_program")

  @@index([promoterId])
  @@index([countryCode, regionId, publication])
  @@index([slug])
  @@index([regionId])
  @@index([cityId])
  @@index([reviewedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("programs")
}

/// 01-domaine/03 § 2 — Property ⌫ ⟳
model Property {
  id                        String                 @id @db.Uuid
  reference                 String                 @db.VarChar(20)
  slug                      String                 @db.VarChar(120)
  promoterId                String                 @map("promoter_id") @db.Uuid
  programId                 String?                @map("program_id") @db.Uuid
  title                     String                 @db.VarChar(120)
  titleAuto                 Boolean                @map("title_auto")
  description               String?                @db.VarChar(5000)
  descriptionAuto           Boolean                @map("description_auto")
  type                      PropertyType
  rooms                     Int?
  bedrooms                  Int?
  bathrooms                 Int?
  surfaceM2                 Decimal                @map("surface_m2") @db.Decimal(8, 2)
  terraceM2                 Decimal?               @map("terrace_m2") @db.Decimal(8, 2)
  landM2                    Decimal?               @map("land_m2") @db.Decimal(10, 2)
  features                  String[]               @default([]) @db.VarChar(40)
  standing                  Standing
  deliveryStatus            DeliveryStatus         @map("delivery_status")
  deliveryDate              DateTime?              @map("delivery_date") @db.Date
  deliveryDatePrecision     DatePrecision          @map("delivery_date_precision")
  deliveryOverridden        Boolean                @map("delivery_overridden")
  countryCode               String                 @map("country_code") @db.Char(2)
  regionId                  String                 @map("region_id") @db.Uuid
  cityId                    String?                @map("city_id") @db.Uuid
  addressLine               String?                @map("address_line") @db.VarChar(200)
  latitude                  Decimal?               @db.Decimal(9, 6)
  longitude                 Decimal?               @db.Decimal(9, 6)
  priceCurrency             String                 @map("price_currency") @db.Char(3)
  highlightLabel            String?                @map("highlight_label") @db.VarChar(40)
  highlightUntil            DateTime?              @map("highlight_until") @db.Date
  featuredRank              Int?                   @map("featured_rank")
  publication               PublicationStatus      @default(DRAFT)
  publishedAt               DateTime?              @map("published_at") @db.Timestamptz(3)
  firstPublishedAt          DateTime?              @map("first_published_at") @db.Timestamptz(3)
  archivedAt                DateTime?              @map("archived_at") @db.Timestamptz(3)
  unpublishedBySuspensionAt DateTime?              @map("unpublished_by_suspension_at") @db.Timestamptz(3)
  unpublishedAt             DateTime?              @map("unpublished_at") @db.Timestamptz(3)
  programCascadeAt          DateTime?              @map("program_cascade_at") @db.Timestamptz(3)
  stockConfirmedAt          DateTime?              @map("stock_confirmed_at") @db.Timestamptz(3)
  stockConfirmedBy          String?                @map("stock_confirmed_by") @db.VarChar(160)
  seoTitle                  String?                @map("seo_title") @db.VarChar(70)
  seoDescription            String?                @map("seo_description") @db.VarChar(160)
  submittedForReviewAt      DateTime?              @map("submitted_for_review_at") @db.Timestamptz(3)
  reviewedAt                DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  reviewedById              String?                @map("reviewed_by_id") @db.Uuid
  reviewNote                String?                @map("review_note") @db.VarChar(500)
  relevanceScore            Int                    @default(0) @map("relevance_score")
  /// cache (MOD-220)
  lotsTotal                 Int                    @default(0) @map("lots_total")
  /// cache
  lotsAvailable             Int                    @default(0) @map("lots_available")
  /// cache
  lotsTaken                 Int                    @default(0) @map("lots_taken")
  /// cache (CYC-110)
  availability              Availability
  /// cache
  availabilityChangedAt     DateTime               @map("availability_changed_at") @db.Timestamptz(3)
  /// cache
  priceFrom                 Decimal?               @map("price_from") @db.Decimal(14, 2)
  /// cache
  priceTo                   Decimal?               @map("price_to") @db.Decimal(14, 2)
  /// cache
  surfaceMin                Decimal?               @map("surface_min") @db.Decimal(8, 2)
  /// cache
  surfaceMax                Decimal?               @map("surface_max") @db.Decimal(8, 2)
  /// cache
  priceFromRef              Decimal?               @map("price_from_ref") @db.Decimal(14, 2)
  /// cache
  downPaymentRef            Decimal?               @map("down_payment_ref") @db.Decimal(14, 2)
  /// cache
  monthlyFromRef            Decimal?               @map("monthly_from_ref") @db.Decimal(12, 2)
  /// cache
  financingEligible         Boolean                @default(false) @map("financing_eligible")
  /// cache
  islamicFinancingEligible  Boolean                @default(false) @map("islamic_financing_eligible")
  /// cache
  has360Tour                Boolean                @default(false) @map("has360_tour")
  /// cache
  hasPlan                   Boolean                @default(false) @map("has_plan")
  /// cache
  hasVideo                  Boolean                @default(false) @map("has_video")
  /// cache
  photoCount                Int                    @default(0) @map("photo_count")
  /// cache
  completenessScore         Int                    @default(0) @map("completeness_score")
  /// cache
  interestCount             Int                    @default(0) @map("interest_count")
  /// cache
  viewCount                 Int                    @default(0) @map("view_count")
  /// cache written by the app (MOD-220): unaccented, lower case; GIN trigram index (MOD-015)
  searchText                String                 @map("search_text") @db.Text
  createdById               String?                @map("created_by_id") @db.Uuid
  updatedById               String?                @map("updated_by_id") @db.Uuid
  deletedAt                 DateTime?              @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version                   Int                    @default(1)
  createdAt                 DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @map("updated_at") @db.Timestamptz(3)

  promoter                  Promoter               @relation("Property_promoter", fields: [promoterId], references: [id], onDelete: Restrict)
  program                   Program?               @relation("Property_program", fields: [programId], references: [id], onDelete: Restrict)
  country                   Country                @relation("Property_country", fields: [countryCode], references: [code], onDelete: Restrict)
  region                    Region                 @relation("Property_region", fields: [regionId], references: [id], onDelete: Restrict)
  city                      City?                  @relation("Property_city", fields: [cityId], references: [id], onDelete: Restrict)
  reviewedBy                User?                  @relation("Property_reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdBy                 User?                  @relation("Property_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 User?                  @relation("Property_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  lots                      Lot[]                  @relation("Lot_property")
  propertyPois              PropertyPoi[]          @relation("PropertyPoi_property")
  financingEligibilities    FinancingEligibility[] @relation("FinancingEligibility_property")
  propertyDailyStats        PropertyDailyStat[]    @relation("PropertyDailyStat_property")
  leads                     Lead[]                 @relation("Lead_property")
  favorites                 Favorite[]             @relation("Favorite_property")
  alertDeliveries           AlertDelivery[]        @relation("AlertDelivery_property")
  dossiers                  Dossier[]              @relation("Dossier_property")
  dossierCandidates         DossierCandidate[]     @relation("DossierCandidate_property")
  appointments              Appointment[]          @relation("Appointment_property")
  simulations               Simulation[]           @relation("Simulation_property")
  tasks                     Task[]                 @relation("Task_property")
  feedbacks                 Feedback[]             @relation("Feedback_property")

  @@index([publication, availability])
  @@index([type])
  @@index([rooms])
  @@index([countryCode, regionId, cityId])
  @@index([priceFromRef])
  @@index([monthlyFromRef])
  @@index([surfaceMin])
  @@index([deliveryDate])
  @@index([standing])
  @@index([promoterId])
  @@index([programId])
  @@index([financingEligible])
  @@index([firstPublishedAt])
  @@index([featuredRank])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([regionId])
  @@index([cityId])
  @@index([reviewedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("properties")
}

/// 01-domaine/03 § 3 — Lot ⌫ ⟳
model Lot {
  id                String             @id @db.Uuid
  propertyId        String             @map("property_id") @db.Uuid
  /// unique per program: application rule under row lock (FIA-020)
  reference         String             @db.VarChar(40)
  referencePending  Boolean            @default(false) @map("reference_pending")
  building          String?            @db.VarChar(40)
  floor             Int?
  door              String?            @db.VarChar(20)
  orientation       Orientation?
  surfaceM2         Decimal            @map("surface_m2") @db.Decimal(8, 2)
  terraceM2         Decimal?           @map("terrace_m2") @db.Decimal(8, 2)
  landM2            Decimal?           @map("land_m2") @db.Decimal(10, 2)
  /// currency: Property.priceCurrency (MOD-008)
  price             Decimal            @db.Decimal(14, 2)
  priceUpdatedAt    DateTime           @map("price_updated_at") @db.Timestamptz(3)
  status            LotStatus          @default(AVAILABLE)
  statusChangedAt   DateTime           @map("status_changed_at") @db.Timestamptz(3)
  statusNote        String?            @map("status_note") @db.VarChar(300)
  externalSale      Boolean            @default(false) @map("external_sale")
  parkingIncluded   Boolean?           @map("parking_included")
  extras            String?            @db.VarChar(300)
  planMediaId       String?            @map("plan_media_id") @db.Uuid
  deliveredAt       DateTime?          @map("delivered_at") @db.Date
  sortOrder         Int                @map("sort_order")
  createdById       String?            @map("created_by_id") @db.Uuid
  updatedById       String?            @map("updated_by_id") @db.Uuid
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version           Int                @default(1)
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @map("updated_at") @db.Timestamptz(3)

  property          Property           @relation("Lot_property", fields: [propertyId], references: [id], onDelete: Restrict)
  planMedia         Media?             @relation("Lot_planMedia", fields: [planMediaId], references: [id], onDelete: Restrict)
  createdBy         User?              @relation("Lot_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?              @relation("Lot_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  leads             Lead[]             @relation("Lead_lot")
  dossiers          Dossier[]          @relation("Dossier_lot")
  dossierCandidates DossierCandidate[] @relation("DossierCandidate_lot")
  reservations      Reservation[]      @relation("Reservation_lot")
  simulations       Simulation[]       @relation("Simulation_lot")

  @@index([propertyId, status])
  @@index([price])
  @@index([propertyId, reference])
  @@index([planMediaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("lots")
}

/// 01-domaine/03 § 4 (ownerId: polymorphic, no FK) — Media ⌫
model Media {
