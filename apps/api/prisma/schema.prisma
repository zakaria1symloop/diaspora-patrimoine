  @@index([propertyId])
  @@map("favorites")
}

/// 01-domaine/04 § 1.5 — SearchAlert
model SearchAlert {
  id                   String                   @id @db.Uuid
  clientId             String?                  @map("client_id") @db.Uuid
  email                String                   @db.Citext
  label                String?                  @db.VarChar(120)
  criteria             Json
  frequency            AlertFrequency           @default(DAILY)
  isActive             Boolean                  @map("is_active")
  confirmedAt          DateTime?                @map("confirmed_at") @db.Timestamptz(3)
  unsubscribeTokenHash String                   @unique @map("unsubscribe_token_hash") @db.Char(64)
  lastSentAt           DateTime?                @map("last_sent_at") @db.Timestamptz(3)
  expiresAt            DateTime                 @map("expires_at") @db.Timestamptz(3)
  expiryNoticeSentAt   DateTime?                @map("expiry_notice_sent_at") @db.Timestamptz(3)
  deactivatedAt        DateTime?                @map("deactivated_at") @db.Timestamptz(3)
  deactivatedReason    AlertDeactivationReason? @map("deactivated_reason")
