  createdAt            DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @map("updated_at") @db.Timestamptz(3)

  event                Event?    @relation("EventNotifyRequest_event", fields: [eventId], references: [id], onDelete: Restrict)
  client               Client?   @relation("EventNotifyRequest_client", fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([email, eventId, locationLabel], map: "event_notify_requests_target_key")
  @@index([eventId])
  @@index([clientId])
  @@map("event_notify_requests")
}

/// 01-domaine/05 § 4.1 — ContentBlock ⟳
model ContentBlock {
  id                   String                @id @db.Uuid
