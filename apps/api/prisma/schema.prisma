// ════════════════════════════════════════════════════════════════════════════
// Diaspora Patrimoine — Prisma schema (work package 1.2, all phases: MOD-017)
// Source of truth: Specs/01-domaine/01 to 05. Generated table by table from the spec.
//
// Conventions (01-domaine/01 § 1):
// - MOD-002 models PascalCase, tables snake_case plural (@@map), columns snake_case (@map).
//   Enums keep their spec names as PostgreSQL type names (no @@map on enums).
// - MOD-003 `id` is a UUID v7 generated by the application: no database default.
// - MOD-004 createdAt/updatedAt are written by the application through Clock (ARC-060):
//   no @default(now()), no @updatedAt. Immutable journal tables have createdAt only.
// - MOD-005 createdById/updatedById on back-office editable tables (null = system).
// - MOD-006 deletedAt on ⌫ tables; their uniqueness constraints are partial indexes
//   (WHERE deleted_at IS NULL) written in the migration SQL, hence absent from this file.
// - MOD-007 version Int @default(1) on ⟳ tables.
// - MOD-008 money = Decimal(14,2) + Char(3) currency; MOD-009 *Bps Int, *Pct Decimal(5,2).
// - MOD-013 every relation has an explicit onDelete (Restrict unless the spec says Cascade
//   or SET NULL) and every foreign key is indexed (MOD-015).
// - "texte (n)" columns are VarChar(n) so the length bound is enforced by the database.
//
// What Prisma cannot express lives in prisma/migrations/*_init/migration.sql, each statement
// citing its rule: partial unique indexes (MOD-006, MOD-019, MOD-102, MOD-310, MOD-330,
// MOD-331, MOD-355…), NULLS NOT DISTINCT keys (MOD-019), CHECK constraints (FIA-002),
// NOT NULL on required list columns, the f_unaccent() function and search triggers.
// Prisma ignores partial indexes and CHECK constraints when diffing, so they do not drift.
// The two NULLS NOT DISTINCT keys without predicate (Conversation, EventNotifyRequest) are
// declared here with @@unique(map: …) and recreated with NULLS NOT DISTINCT in the SQL under
// the same name: Prisma sees an identical unique index.
//
// Search columns (MOD-015, ARC-074, TRV-103):
// - Client.searchText is computed by the database: BEFORE INSERT/UPDATE trigger
//   `clients_search_text` writes lower(f_unaccent(name, e-mail, phone, city)). It is a
//   plain text column for Prisma (a GENERATED column makes Prisma's diff drift); the
//   application never writes it (the trigger overwrites any value).
// - Property.searchText spans other tables (program, promoter, city, region), so it is the
//   cache of MOD-220, written unaccented and lower-cased by the application.
// Both have a GIN trigram index declared below (ops: gin_trgm_ops).
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm, unaccent, pgcrypto]
}

// ──────────────────────────────────────────────────────────────────────────
// 01-domaine/02 — Identité, référentiels, partenaires
// ──────────────────────────────────────────────────────────────────────────

/// 01-domaine/02 § 1.1 — User
model User {
  id                                String                   @id @db.Uuid
  kind                              UserKind
  email                             String                   @unique @db.Citext
  emailVerifiedAt                   DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  pendingEmail                      String?                  @map("pending_email") @db.Citext
  passwordHash                      String?                  @map("password_hash") @db.Text
  passwordChangedAt                 DateTime?                @map("password_changed_at") @db.Timestamptz(3)
  firstName                         String?                  @map("first_name") @db.VarChar(80)
  lastName                          String?                  @map("last_name") @db.VarChar(80)
  phone                             String?                  @db.VarChar(20)
  locale                            Locale                   @default(fr)
  timezone                          String                   @default("Europe/Paris") @db.VarChar(64)
  status                            UserStatus               @default(ACTIVE)
  suspendedAt                       DateTime?                @map("suspended_at") @db.Timestamptz(3)
  suspendedReason                   SuspensionReason?        @map("suspended_reason")
  suspendedNote                     String?                  @map("suspended_note") @db.VarChar(300)
  jobTitle                          String?                  @map("job_title") @db.VarChar(80)
  signature                         String?                  @db.VarChar(500)
  avatarMediaId                     String?                  @map("avatar_media_id") @db.Uuid
  twoFactorEnabled                  Boolean                  @default(false) @map("two_factor_enabled")
  /// MOD-016: encrypted by the app (AES-256-GCM)
  twoFactorSecret                   String?                  @map("two_factor_secret") @db.Text
  /// MOD-016: encrypted by the app
  twoFactorPendingSecret            String?                  @map("two_factor_pending_secret") @db.Text
  twoFactorRecoveryHashes           Json?                    @map("two_factor_recovery_hashes")
  failedLoginCount                  Int                      @default(0) @map("failed_login_count")
  lockedUntil                       DateTime?                @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                       DateTime?                @map("last_login_at") @db.Timestamptz(3)
  lastSeenAt                        DateTime?                @map("last_seen_at") @db.Timestamptz(3)
  charterAcceptedAt                 DateTime?                @map("charter_accepted_at") @db.Timestamptz(3)
  createdById                       String?                  @map("created_by_id") @db.Uuid
  updatedById                       String?                  @map("updated_by_id") @db.Uuid
  createdAt                         DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                 @map("updated_at") @db.Timestamptz(3)

  avatarMedia                       Media?                   @relation("User_avatarMedia", fields: [avatarMediaId], references: [id], onDelete: Restrict)
  createdBy                         User?                    @relation("User_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                         User?                    @relation("User_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  membershipsAsUser                 Membership[]             @relation("Membership_user")
  membershipsAsInvitedBy            Membership[]             @relation("Membership_invitedBy")
  sessionsAsUser                    Session[]                @relation("Session_user")
  sessionsAsImpersonatedBy          Session[]                @relation("Session_impersonatedBy")
  authTokens                        AuthToken[]              @relation("AuthToken_user")
  consentsAsUser                    Consent[]                @relation("Consent_user")
  consentsAsRecordedBy              Consent[]                @relation("Consent_recordedBy")
  pushDevices                       PushDevice[]             @relation("PushDevice_user")
  exchangeRatesAsVoidedBy           ExchangeRate[]           @relation("ExchangeRate_voidedBy")
  promotersAsAccountManager         Promoter[]               @relation("Promoter_accountManager")
  promotersAsVettedBy               Promoter[]               @relation("Promoter_vettedBy")
  promoterContactsAsUser            PromoterContact[]        @relation("PromoterContact_user")
  banksAsAccountManager             Bank[]                   @relation("Bank_accountManager")
  bankContactsAsUser                BankContact[]            @relation("BankContact_user")
  partnerDocumentsAsUploadedBy      PartnerDocument[]        @relation("PartnerDocument_uploadedBy")
  partnerAnswersAsUser              PartnerAnswer[]          @relation("PartnerAnswer_user")
  partnerAnswersAsReviewedBy        PartnerAnswer[]          @relation("PartnerAnswer_reviewedBy")
  programsAsReviewedBy              Program[]                @relation("Program_reviewedBy")
  propertiesAsReviewedBy            Property[]               @relation("Property_reviewedBy")
  mediaAsUploadedBy                 Media[]                  @relation("Media_uploadedBy")
  financingEligibilitiesAsCheckedBy FinancingEligibility[]   @relation("FinancingEligibility_checkedBy")
  clientsAsUser                     Client[]                 @relation("Client_user")
  clientsAsQualifiedBy              Client[]                 @relation("Client_qualifiedBy")
  clientsAsAssignedAgent            Client[]                 @relation("Client_assignedAgent")
  leadsAsApplicantUser              Lead[]                   @relation("Lead_applicantUser")
  leadsAsReviewedBy                 Lead[]                   @relation("Lead_reviewedBy")
  leadsAsAssignedAgent              Lead[]                   @relation("Lead_assignedAgent")
  leadsAsClosedBy                   Lead[]                   @relation("Lead_closedBy")
  leadFiles                         LeadFile[]               @relation("LeadFile_uploadedBy")
  notesAsAuthor                     Note[]                   @relation("Note_author")
  dossiersAsAssignedAgent           Dossier[]                @relation("Dossier_assignedAgent")
  dossierStageHistories             DossierStageHistory[]    @relation("DossierStageHistory_changedBy")
  dossierCandidatesAsProposedBy     DossierCandidate[]       @relation("DossierCandidate_proposedBy")
  reservationsAsCreatedBy           Reservation[]            @relation("Reservation_createdBy")
  appointmentsAsStaffUser           Appointment[]            @relation("Appointment_staffUser")
  dossierDocumentsAsValidatedBy     DossierDocument[]        @relation("DossierDocument_validatedBy")
  dossierDocumentsAsWaivedBy        DossierDocument[]        @relation("DossierDocument_waivedBy")
  documentVersionsAsUploadedBy      DocumentVersion[]        @relation("DocumentVersion_uploadedBy")
  documentVersionsAsDecidedBy       DocumentVersion[]        @relation("DocumentVersion_decidedBy")
  documentVersionsAsDeletedBy       DocumentVersion[]        @relation("DocumentVersion_deletedBy")
  documentReminders                 DocumentReminder[]       @relation("DocumentReminder_triggeredBy")
  bankSubmissionsAsSubmittedBy      BankSubmission[]         @relation("BankSubmission_submittedBy")
  submissionPackages                SubmissionPackage[]      @relation("SubmissionPackage_generatedBy")
  secureSharesAsRevokedBy           SecureShare[]            @relation("SecureShare_revokedBy")
  secureSharesAsCreatedBy           SecureShare[]            @relation("SecureShare_createdBy")
  bankSubmissionEvents              BankSubmissionEvent[]    @relation("BankSubmissionEvent_actor")
  simulations                       Simulation[]             @relation("Simulation_createdBy")
  emailTemplateVersions             EmailTemplateVersion[]   @relation("EmailTemplateVersion_updatedBy")
  communicationsAsStaffUser         Communication[]          @relation("Communication_staffUser")
  communicationsAsSentBy            Communication[]          @relation("Communication_sentBy")
  messages                          Message[]                @relation("Message_senderUser")
  notifications                     Notification[]           @relation("Notification_user")
  notificationPreferences           NotificationPreference[] @relation("NotificationPreference_user")
  tasksAsAssignee                   Task[]                   @relation("Task_assignee")
  tasksAsCreatedBy                  Task[]                   @relation("Task_createdBy")
  tasksAsCompletedBy                Task[]                   @relation("Task_completedBy")
  feedbacksAsHandledBy              Feedback[]               @relation("Feedback_handledBy")
  eventsAsHostUser                  Event[]                  @relation("Event_hostUser")
  eventRegistrationsAsCheckedInBy   EventRegistration[]      @relation("EventRegistration_checkedInBy")
  contentBlockVersions              ContentBlockVersion[]    @relation("ContentBlockVersion_updatedBy")
  auditLogs                         AuditLog[]               @relation("AuditLog_actor")
  idempotencyKeys                   IdempotencyKey[]         @relation("IdempotencyKey_user")
  dataRequestsAsHandledBy           DataRequest[]            @relation("DataRequest_handledBy")
  savedViews                        SavedView[]              @relation("SavedView_owner")
  savedViewDefaults                 SavedViewDefault[]       @relation("SavedViewDefault_user")
  jobRuns                           JobRun[]                 @relation("JobRun_triggeredBy")
  importJobs                        ImportJob[]              @relation("ImportJob_createdBy")
  exportJobs                        ExportJob[]              @relation("ExportJob_requestedBy")
  uploads                           Upload[]                 @relation("Upload_requestedBy")
  usersAsCreatedBy                  User[]                   @relation("User_createdBy")
  usersAsUpdatedBy                  User[]                   @relation("User_updatedBy")
  organizationsAsCreatedBy          Organization[]           @relation("Organization_createdBy")
  organizationsAsUpdatedBy          Organization[]           @relation("Organization_updatedBy")
  membershipsAsCreatedBy            Membership[]             @relation("Membership_createdBy")
  membershipsAsUpdatedBy            Membership[]             @relation("Membership_updatedBy")
  countriesAsCreatedBy              Country[]                @relation("Country_createdBy")
  countriesAsUpdatedBy              Country[]                @relation("Country_updatedBy")
  regionsAsCreatedBy                Region[]                 @relation("Region_createdBy")
  regionsAsUpdatedBy                Region[]                 @relation("Region_updatedBy")
  citiesAsCreatedBy                 City[]                   @relation("City_createdBy")
  citiesAsUpdatedBy                 City[]                   @relation("City_updatedBy")
  travelTimesAsCreatedBy            TravelTime[]             @relation("TravelTime_createdBy")
  travelTimesAsUpdatedBy            TravelTime[]             @relation("TravelTime_updatedBy")
  exchangeRatesAsCreatedBy          ExchangeRate[]           @relation("ExchangeRate_createdBy")
  holidaysAsCreatedBy               Holiday[]                @relation("Holiday_createdBy")
  holidaysAsUpdatedBy               Holiday[]                @relation("Holiday_updatedBy")
  promotersAsCreatedBy              Promoter[]               @relation("Promoter_createdBy")
  promotersAsUpdatedBy              Promoter[]               @relation("Promoter_updatedBy")
  promoterContactsAsCreatedBy       PromoterContact[]        @relation("PromoterContact_createdBy")
  promoterContactsAsUpdatedBy       PromoterContact[]        @relation("PromoterContact_updatedBy")
  banksAsCreatedBy                  Bank[]                   @relation("Bank_createdBy")
  banksAsUpdatedBy                  Bank[]                   @relation("Bank_updatedBy")
  bankContactsAsCreatedBy           BankContact[]            @relation("BankContact_createdBy")
  bankContactsAsUpdatedBy           BankContact[]            @relation("BankContact_updatedBy")
  bankProductsAsCreatedBy           BankProduct[]            @relation("BankProduct_createdBy")
  bankProductsAsUpdatedBy           BankProduct[]            @relation("BankProduct_updatedBy")
  partnersAsCreatedBy               Partner[]                @relation("Partner_createdBy")
  partnersAsUpdatedBy               Partner[]                @relation("Partner_updatedBy")
  partnerDocumentsAsCreatedBy       PartnerDocument[]        @relation("PartnerDocument_createdBy")
  partnerDocumentsAsUpdatedBy       PartnerDocument[]        @relation("PartnerDocument_updatedBy")
  programsAsCreatedBy               Program[]                @relation("Program_createdBy")
  programsAsUpdatedBy               Program[]                @relation("Program_updatedBy")
  propertiesAsCreatedBy             Property[]               @relation("Property_createdBy")
  propertiesAsUpdatedBy             Property[]               @relation("Property_updatedBy")
  lotsAsCreatedBy                   Lot[]                    @relation("Lot_createdBy")
  lotsAsUpdatedBy                   Lot[]                    @relation("Lot_updatedBy")
  mediaAsCreatedBy                  Media[]                  @relation("Media_createdBy")
  mediaAsUpdatedBy                  Media[]                  @relation("Media_updatedBy")
  propertyPoisAsCreatedBy           PropertyPoi[]            @relation("PropertyPoi_createdBy")
  propertyPoisAsUpdatedBy           PropertyPoi[]            @relation("PropertyPoi_updatedBy")
  programUpdatesAsCreatedBy         ProgramUpdate[]          @relation("ProgramUpdate_createdBy")
  programUpdatesAsUpdatedBy         ProgramUpdate[]          @relation("ProgramUpdate_updatedBy")
  financingEligibilitiesAsCreatedBy FinancingEligibility[]   @relation("FinancingEligibility_createdBy")
  financingEligibilitiesAsUpdatedBy FinancingEligibility[]   @relation("FinancingEligibility_updatedBy")
  clientsAsCreatedBy                Client[]                 @relation("Client_createdBy")
  clientsAsUpdatedBy                Client[]                 @relation("Client_updatedBy")
  clientContactsAsCreatedBy         ClientContact[]          @relation("ClientContact_createdBy")
  clientContactsAsUpdatedBy         ClientContact[]          @relation("ClientContact_updatedBy")
  leadsAsCreatedBy                  Lead[]                   @relation("Lead_createdBy")
  leadsAsUpdatedBy                  Lead[]                   @relation("Lead_updatedBy")
  notesAsCreatedBy                  Note[]                   @relation("Note_createdBy")
  notesAsUpdatedBy                  Note[]                   @relation("Note_updatedBy")
  dossiersAsCreatedBy               Dossier[]                @relation("Dossier_createdBy")
  dossiersAsUpdatedBy               Dossier[]                @relation("Dossier_updatedBy")
  dossierPartiesAsCreatedBy         DossierParty[]           @relation("DossierParty_createdBy")
  dossierPartiesAsUpdatedBy         DossierParty[]           @relation("DossierParty_updatedBy")
  dossierCandidatesAsCreatedBy      DossierCandidate[]       @relation("DossierCandidate_createdBy")
  dossierCandidatesAsUpdatedBy      DossierCandidate[]       @relation("DossierCandidate_updatedBy")
  reservationsAsUpdatedBy           Reservation[]            @relation("Reservation_updatedBy")
  appointmentsAsCreatedBy           Appointment[]            @relation("Appointment_createdBy")
  appointmentsAsUpdatedBy           Appointment[]            @relation("Appointment_updatedBy")
  checklistTemplatesAsCreatedBy     ChecklistTemplate[]      @relation("ChecklistTemplate_createdBy")
  checklistTemplatesAsUpdatedBy     ChecklistTemplate[]      @relation("ChecklistTemplate_updatedBy")
  checklistItemsAsCreatedBy         ChecklistItem[]          @relation("ChecklistItem_createdBy")
  checklistItemsAsUpdatedBy         ChecklistItem[]          @relation("ChecklistItem_updatedBy")
  dossierDocumentsAsCreatedBy       DossierDocument[]        @relation("DossierDocument_createdBy")
  dossierDocumentsAsUpdatedBy       DossierDocument[]        @relation("DossierDocument_updatedBy")
  bankSubmissionsAsCreatedBy        BankSubmission[]         @relation("BankSubmission_createdBy")
  bankSubmissionsAsUpdatedBy        BankSubmission[]         @relation("BankSubmission_updatedBy")
  submissionDocumentsAsCreatedBy    SubmissionDocument[]     @relation("SubmissionDocument_createdBy")
  submissionDocumentsAsUpdatedBy    SubmissionDocument[]     @relation("SubmissionDocument_updatedBy")
  emailTemplatesAsCreatedBy         EmailTemplate[]          @relation("EmailTemplate_createdBy")
  emailTemplatesAsUpdatedBy         EmailTemplate[]          @relation("EmailTemplate_updatedBy")
  workflowRulesAsCreatedBy          WorkflowRule[]           @relation("WorkflowRule_createdBy")
  workflowRulesAsUpdatedBy          WorkflowRule[]           @relation("WorkflowRule_updatedBy")
  tasksAsUpdatedBy                  Task[]                   @relation("Task_updatedBy")
  surveysAsCreatedBy                Survey[]                 @relation("Survey_createdBy")
  surveysAsUpdatedBy                Survey[]                 @relation("Survey_updatedBy")
  feedbacksAsCreatedBy              Feedback[]               @relation("Feedback_createdBy")
  feedbacksAsUpdatedBy              Feedback[]               @relation("Feedback_updatedBy")
  eventsAsCreatedBy                 Event[]                  @relation("Event_createdBy")
  eventsAsUpdatedBy                 Event[]                  @relation("Event_updatedBy")
  eventPartnersAsCreatedBy          EventPartner[]           @relation("EventPartner_createdBy")
  eventPartnersAsUpdatedBy          EventPartner[]           @relation("EventPartner_updatedBy")
  eventRegistrationsAsCreatedBy     EventRegistration[]      @relation("EventRegistration_createdBy")
  eventRegistrationsAsUpdatedBy     EventRegistration[]      @relation("EventRegistration_updatedBy")
  contentBlocksAsCreatedBy          ContentBlock[]           @relation("ContentBlock_createdBy")
  contentBlocksAsUpdatedBy          ContentBlock[]           @relation("ContentBlock_updatedBy")
  pagesAsCreatedBy                  Page[]                   @relation("Page_createdBy")
  pagesAsUpdatedBy                  Page[]                   @relation("Page_updatedBy")
  faqItemsAsCreatedBy               FaqItem[]                @relation("FaqItem_createdBy")
  faqItemsAsUpdatedBy               FaqItem[]                @relation("FaqItem_updatedBy")
  testimonialsAsCreatedBy           Testimonial[]            @relation("Testimonial_createdBy")
  testimonialsAsUpdatedBy           Testimonial[]            @relation("Testimonial_updatedBy")
  legalDocumentsAsCreatedBy         LegalDocument[]          @relation("LegalDocument_createdBy")
  legalDocumentsAsUpdatedBy         LegalDocument[]          @relation("LegalDocument_updatedBy")
  redirectsAsCreatedBy              Redirect[]               @relation("Redirect_createdBy")
  redirectsAsUpdatedBy              Redirect[]               @relation("Redirect_updatedBy")
  translationsAsCreatedBy           Translation[]            @relation("Translation_createdBy")
  translationsAsUpdatedBy           Translation[]            @relation("Translation_updatedBy")
  settingsAsCreatedBy               Setting[]                @relation("Setting_createdBy")
  settingsAsUpdatedBy               Setting[]                @relation("Setting_updatedBy")
  dataRequestsAsCreatedBy           DataRequest[]            @relation("DataRequest_createdBy")
  dataRequestsAsUpdatedBy           DataRequest[]            @relation("DataRequest_updatedBy")

  @@index([status])
  @@index([kind])
  @@index([avatarMediaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("users")
}

/// 01-domaine/02 § 1.2 — Organization
model Organization {
  id             String           @id @db.Uuid
  type           OrganizationType
  name           String           @db.VarChar(160)
  slug           String           @unique @db.VarChar(80)
  createdById    String?          @map("created_by_id") @db.Uuid
  updatedById    String?          @map("updated_by_id") @db.Uuid
  createdAt      DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @map("updated_at") @db.Timestamptz(3)

  createdBy      User?            @relation("Organization_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?            @relation("Organization_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  memberships    Membership[]     @relation("Membership_organization")
  promoters      Promoter[]       @relation("Promoter_organization")
  banks          Bank[]           @relation("Bank_organization")
  partnerAnswers PartnerAnswer[]  @relation("PartnerAnswer_organization")
  secureShares   SecureShare[]    @relation("SecureShare_organization")
  conversations  Conversation[]   @relation("Conversation_partnerOrganization")
  feedbacks      Feedback[]       @relation("Feedback_authorOrganization")
  auditLogs      AuditLog[]       @relation("AuditLog_partnerOrganization")

  @@index([createdById])
  @@index([updatedById])
  @@map("organizations")
}

/// 01-domaine/02 § 1.3 — Membership
model Membership {
  id              String          @id @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  role            MembershipRole
  invitedById     String?         @map("invited_by_id") @db.Uuid
  invitedAt       DateTime        @map("invited_at") @db.Timestamptz(3)
  acceptedAt      DateTime?       @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  suspendedAt     DateTime?       @map("suspended_at") @db.Timestamptz(3)
  elevatedRole    MembershipRole? @map("elevated_role")
  elevatedUntil   DateTime?       @map("elevated_until") @db.Timestamptz(3)
  elevationReason String?         @map("elevation_reason") @db.VarChar(500)
  receivesLeads   Boolean         @map("receives_leads")
  absentUntil     DateTime?       @map("absent_until") @db.Date
  createdById     String?         @map("created_by_id") @db.Uuid
  updatedById     String?         @map("updated_by_id") @db.Uuid
  createdAt       DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @map("updated_at") @db.Timestamptz(3)

  user            User            @relation("Membership_user", fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization    @relation("Membership_organization", fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy       User?           @relation("Membership_invitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("Membership_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?           @relation("Membership_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, role])
  @@index([userId])
  @@index([invitedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("memberships")
}

/// 01-domaine/02 § 1.4 — Session
model Session {
  id                       String                @id @db.Uuid
  userId                   String                @map("user_id") @db.Uuid
  audience                 SessionAudience
  familyId                 String                @map("family_id") @db.Uuid
  refreshTokenHash         String                @unique @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash String?               @map("previous_refresh_token_hash") @db.Char(64)
  rotatedAt                DateTime?             @map("rotated_at") @db.Timestamptz(3)
  impersonatedById         String?               @map("impersonated_by_id") @db.Uuid
  rememberMe               Boolean               @map("remember_me")
  userAgent                String?               @map("user_agent") @db.VarChar(400)
  deviceLabel              String?               @map("device_label") @db.VarChar(120)
  ipHash                   String?               @map("ip_hash") @db.Char(64)
  lastUsedAt               DateTime              @map("last_used_at") @db.Timestamptz(3)
  passwordConfirmedAt      DateTime?             @map("password_confirmed_at") @db.Timestamptz(3)
  expiresAt                DateTime              @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason            SessionRevokedReason? @map("revoked_reason")
  deviceKey                String?               @map("device_key") @db.Char(64)
  createdAt                DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @map("updated_at") @db.Timestamptz(3)

  user                     User                  @relation("Session_user", fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy           User?                 @relation("Session_impersonatedBy", fields: [impersonatedById], references: [id], onDelete: Restrict)

  @@index([familyId])
  @@index([userId])
  @@index([impersonatedById])
  @@map("sessions")
}

/// 01-domaine/02 § 1.5 — AuthToken
model AuthToken {
  id        String           @id @db.Uuid
  purpose   AuthTokenPurpose
  userId    String?          @map("user_id") @db.Uuid
  email     String           @db.Citext
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  payload   Json?
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  attempts  Int              @default(0)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  ipHash    String?          @map("ip_hash") @db.Char(64)
  createdAt DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @map("updated_at") @db.Timestamptz(3)

  user      User?            @relation("AuthToken_user", fields: [userId], references: [id], onDelete: Restrict)

  @@index([email, purpose])
  @@index([userId])
  @@map("auth_tokens")
}

/// 01-domaine/02 § 1.6 (immutable) — Consent
model Consent {
  id                    String             @id @db.Uuid
  type                  ConsentType
  granted               Boolean
  userId                String?            @map("user_id") @db.Uuid
  clientId              String?            @map("client_id") @db.Uuid
  leadId                String?            @map("lead_id") @db.Uuid
  registrationId        String?            @map("registration_id") @db.Uuid
  partyId               String?            @map("party_id") @db.Uuid
  documentVersion       String?            @map("document_version") @db.VarChar(40)
  wording               String?            @db.Text
  source                String             @db.VarChar(60)
  sourceCommunicationId String?            @map("source_communication_id") @db.Uuid
  givenAt               DateTime           @map("given_at") @db.Timestamptz(3)
  recordedById          String?            @map("recorded_by_id") @db.Uuid
