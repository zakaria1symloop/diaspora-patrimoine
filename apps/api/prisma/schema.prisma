  @@index([uploadedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("media")
}

/// 01-domaine/03 § 5 — PropertyPoi
model PropertyPoi {
  id          String      @id @db.Uuid
  programId   String?     @map("program_id") @db.Uuid
  propertyId  String?     @map("property_id") @db.Uuid
  label       String      @db.VarChar(120)
