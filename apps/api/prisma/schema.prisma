  template    EmailTemplate @relation("EmailTemplateVersion_template", fields: [templateId], references: [id], onDelete: Cascade)
  updatedBy   User?         @relation("EmailTemplateVersion_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
  @@index([updatedById])
  @@map("email_template_versions")
}

/// 01-domaine/05 § 1.2 — Communication
model Communication {
  id                String             @id @db.Uuid
  channel           Channel
  direction         Direction          @default(OUTBOUND)
  clientId          String?            @map("client_id") @db.Uuid
  dossierId         String?            @map("dossier_id") @db.Uuid
  leadId            String?            @map("lead_id") @db.Uuid
  submissionId      String?            @map("submission_id") @db.Uuid
  eventId           String?            @map("event_id") @db.Uuid
  registrationId    String?            @map("registration_id") @db.Uuid
  simulationId      String?            @map("simulation_id") @db.Uuid
  promoterId        String?            @map("promoter_id") @db.Uuid
  bankId            String?            @map("bank_id") @db.Uuid
  feedbackId        String?            @map("feedback_id") @db.Uuid
  dataRequestId     String?            @map("data_request_id") @db.Uuid
  exportJobId       String?            @map("export_job_id") @db.Uuid
  staffUserId       String?            @map("staff_user_id") @db.Uuid
  templateCode      String?            @map("template_code") @db.VarChar(60)
  templateVersion   Int?               @map("template_version")
  subject           String?            @db.VarChar(200)
  /// Redacted: no token link, code or message excerpt (NOT-002, NOT-017)
  body              String?            @db.Text
  toAddress         String?            @map("to_address") @db.Citext
  /// optional (nullable list)
  ccAddresses       String[]           @map("cc_addresses") @db.Citext
  fromAddress       String?            @map("from_address") @db.Citext
  replyTo           String?            @map("reply_to") @db.Citext
  attachments       Json?
  providerMessageId String?            @map("provider_message_id") @db.VarChar(200)
  /// E-mail only (null for other channels)
  deliveryState     DeliveryState?     @default(QUEUED) @map("delivery_state")
  triggeredBy       TriggerKind        @map("triggered_by")
  ruleId            String?            @map("rule_id") @db.Uuid
  sentById          String?            @map("sent_by_id") @db.Uuid
  scheduledFor      DateTime?          @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(3)
  openedAt          DateTime?          @map("opened_at") @db.Timestamptz(3)
  clickedAt         DateTime?          @map("clicked_at") @db.Timestamptz(3)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(3)
  failureReason     String?            @map("failure_reason") @db.VarChar(300)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  bouncedAt         DateTime?          @map("bounced_at") @db.Timestamptz(3)
  complainedAt      DateTime?          @map("complained_at") @db.Timestamptz(3)
  stateHistory      Json               @default("[]") @map("state_history")
  resentFromId      String?            @map("resent_from_id") @db.Uuid
  occurredAt        DateTime           @map("occurred_at") @db.Timestamptz(3)
  durationMinutes   Int?               @map("duration_minutes")
  callOutcome       CallOutcome?       @map("call_outcome")
  /// MOD-019: unique among filled values (PostgreSQL NULLs are distinct)
  dedupeKey         String?            @unique @map("dedupe_key") @db.VarChar(200)
  metadata          Json?
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @map("updated_at") @db.Timestamptz(3)

  client            Client?            @relation("Communication_client", fields: [clientId], references: [id], onDelete: Restrict)
  dossier           Dossier?           @relation("Communication_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  lead              Lead?              @relation("Communication_lead", fields: [leadId], references: [id], onDelete: Restrict)
  submission        BankSubmission?    @relation("Communication_submission", fields: [submissionId], references: [id], onDelete: Restrict)
  event             Event?             @relation("Communication_event", fields: [eventId], references: [id], onDelete: Restrict)
  registration      EventRegistration? @relation("Communication_registration", fields: [registrationId], references: [id], onDelete: Restrict)
  simulation        Simulation?        @relation("Communication_simulation", fields: [simulationId], references: [id], onDelete: Cascade)
  promoter          Promoter?          @relation("Communication_promoter", fields: [promoterId], references: [id], onDelete: Restrict)
  bank              Bank?              @relation("Communication_bank", fields: [bankId], references: [id], onDelete: Restrict)
  feedback          Feedback?          @relation("Communication_feedback", fields: [feedbackId], references: [id], onDelete: Restrict)
  dataRequest       DataRequest?       @relation("Communication_dataRequest", fields: [dataRequestId], references: [id], onDelete: Restrict)
  exportJob         ExportJob?         @relation("Communication_exportJob", fields: [exportJobId], references: [id], onDelete: Restrict)
  staffUser         User?              @relation("Communication_staffUser", fields: [staffUserId], references: [id], onDelete: Restrict)
  rule              WorkflowRule?      @relation("Communication_rule", fields: [ruleId], references: [id], onDelete: Restrict)
  sentBy            User?              @relation("Communication_sentBy", fields: [sentById], references: [id], onDelete: Restrict)
  resentFrom        Communication?     @relation("Communication_resentFrom", fields: [resentFromId], references: [id], onDelete: Restrict)

  consents          Consent[]          @relation("Consent_sourceCommunication")
  documentReminders DocumentReminder[] @relation("DocumentReminder_communication")
  resends           Communication[]    @relation("Communication_resentFrom")

  @@index([dossierId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([providerMessageId])
  @@index([deliveryState, scheduledFor])
  @@index([leadId])
  @@index([submissionId])
  @@index([eventId])
  @@index([registrationId])
  @@index([simulationId])
  @@index([promoterId])
  @@index([bankId])
  @@index([feedbackId])
  @@index([dataRequestId])
  @@index([exportJobId])
  @@index([staffUserId])
  @@index([ruleId])
  @@index([sentById])
  @@index([resentFromId])
  @@map("communications")
}

