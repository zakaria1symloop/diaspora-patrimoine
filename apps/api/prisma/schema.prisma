  createdAt   DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @map("updated_at") @db.Timestamptz(3)

  program     Program           @relation("ProgramUpdate_program", fields: [programId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("ProgramUpdate_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("ProgramUpdate_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([programId])
  @@index([createdById])
  @@index([updatedById])
  @@map("program_updates")
}

/// 01-domaine/03 § 7 — FinancingEligibility
model FinancingEligibility {
  id          String    @id @db.Uuid
  bankId      String    @map("bank_id") @db.Uuid
  programId   String?   @map("program_id") @db.Uuid
  propertyId  String?   @map("property_id") @db.Uuid
  accepted    Boolean
  note        String?   @db.VarChar(300)
  checkedAt   DateTime  @map("checked_at") @db.Date
  checkedById String?   @map("checked_by_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)

  bank        Bank      @relation("FinancingEligibility_bank", fields: [bankId], references: [id], onDelete: Cascade)
  program     Program?  @relation("FinancingEligibility_program", fields: [programId], references: [id], onDelete: Cascade)
  property    Property? @relation("FinancingEligibility_property", fields: [propertyId], references: [id], onDelete: Cascade)
  checkedBy   User?     @relation("FinancingEligibility_checkedBy", fields: [checkedById], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("FinancingEligibility_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("FinancingEligibility_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([bankId, programId])
  @@unique([bankId, propertyId])
  @@index([programId])
  @@index([propertyId])
  @@index([checkedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("financing_eligibilities")
}

/// 01-domaine/03 § 8 (entityId: polymorphic, no FK) — SlugHistory
model SlugHistory {
  id         String         @id @db.Uuid
