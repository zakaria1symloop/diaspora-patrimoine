  caption               String?          @db.VarChar(200)
  roomLabel             String?          @map("room_label") @db.VarChar(60)
  isCover               Boolean          @map("is_cover")
  isIllustration        Boolean          @default(false) @map("is_illustration")
  takenAt               DateTime?        @map("taken_at") @db.Date
  sortOrder             Int              @map("sort_order")
  processingStatus      ProcessingStatus @map("processing_status")
  processingError       String?          @map("processing_error") @db.VarChar(300)
  uploadedById          String?          @map("uploaded_by_id") @db.Uuid
  createdById           String?          @map("created_by_id") @db.Uuid
  updatedById           String?          @map("updated_by_id") @db.Uuid
  deletedAt             DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt             DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @map("updated_at") @db.Timestamptz(3)

  uploadedBy            User?            @relation("Media_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdBy             User?            @relation("Media_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User?            @relation("Media_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  users                 User[]           @relation("User_avatarMedia")
  promotersAsLogoMedia  Promoter[]       @relation("Promoter_logoMedia")
  promotersAsCoverMedia Promoter[]       @relation("Promoter_coverMedia")
