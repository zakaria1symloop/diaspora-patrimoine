/// 01-domaine/05 § 1.3 (⌫ but never in the trash: MOD-006) — Message ⌫
model Message {
  id                 String              @id @db.Uuid
  conversationId     String              @map("conversation_id") @db.Uuid
  senderType         MessageSenderType   @map("sender_type")
  senderUserId       String?             @map("sender_user_id") @db.Uuid
  body               String              @db.VarChar(4000)
  readByClientAt     DateTime?           @map("read_by_client_at") @db.Timestamptz(3)
  readByStaffAt      DateTime?           @map("read_by_staff_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @map("updated_at") @db.Timestamptz(3)

  conversation       Conversation        @relation("Message_conversation", fields: [conversationId], references: [id], onDelete: Restrict)
  senderUser         User?               @relation("Message_senderUser", fields: [senderUserId], references: [id], onDelete: Restrict)

  messageAttachments MessageAttachment[] @relation("MessageAttachment_message")

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@map("messages")
}

/// 01-domaine/05 § 1.3 — MessageAttachment
model MessageAttachment {
  id                String           @id @db.Uuid
  messageId         String           @map("message_id") @db.Uuid
  storageKey        String           @map("storage_key") @db.VarChar(400)
  fileName          String           @map("file_name") @db.VarChar(200)
  mimeType          String           @map("mime_type") @db.VarChar(100)
  sizeBytes         BigInt           @map("size_bytes")
  checksumSha256    String           @map("checksum_sha256") @db.Char(64)
  scanStatus        ScanStatus       @default(PENDING) @map("scan_status")
  filedAsDocumentId String?          @map("filed_as_document_id") @db.Uuid
  filesPurgedAt     DateTime?        @map("files_purged_at") @db.Timestamptz(3)
  createdAt         DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @map("updated_at") @db.Timestamptz(3)

  message           Message          @relation("MessageAttachment_message", fields: [messageId], references: [id], onDelete: Cascade)
  filedAsDocument   DossierDocument? @relation("MessageAttachment_filedAsDocument", fields: [filedAsDocumentId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([filedAsDocumentId])
  @@map("message_attachments")
}

/// 01-domaine/05 § 1.4 (entityId: polymorphic, no FK) — Notification
model Notification {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(160)
  titlePlural String?   @map("title_plural") @db.VarChar(160)
  body        String?   @db.VarChar(400)
  link        String?   @db.VarChar(400)
  entityType  String?   @map("entity_type") @db.VarChar(40)
  entityId    String?   @map("entity_id") @db.Uuid
  count       Int       @default(1)
  dedupeKey   String?   @map("dedupe_key") @db.VarChar(200)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)

  user        User      @relation("Notification_user", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, updatedAt])
  @@map("notifications")
}

/// 01-domaine/05 § 1.4 — NotificationPreference
model NotificationPreference {
