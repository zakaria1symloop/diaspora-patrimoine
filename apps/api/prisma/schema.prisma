  clientId     String?  @map("client_id") @db.Uuid
  group        String   @db.VarChar(40)
  emailEnabled Boolean  @map("email_enabled")
  pushEnabled  Boolean  @map("push_enabled")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)

  user         User?    @relation("NotificationPreference_user", fields: [userId], references: [id], onDelete: Cascade)
  client       Client?  @relation("NotificationPreference_client", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@map("notification_preferences")
}

/// 01-domaine/05 § 1.5 (deletedAt marks a state, outside MOD-006) — WorkflowRule ⟳
model WorkflowRule {
  id                 String              @id @db.Uuid
  /// MOD-019: unique among filled values (PostgreSQL NULLs are distinct)
  code               String?             @unique @db.VarChar(60)
  name               String              @db.VarChar(160)
  description        String?             @db.VarChar(500)
  trigger            String              @db.VarChar(60)
  conditions         Json?
  delayValue         Int                 @default(0) @map("delay_value")
  delayUnit          DelayUnit           @default(MINUTES) @map("delay_unit")
  actions            Json
  isActive           Boolean             @map("is_active")
  isSystem           Boolean             @map("is_system")
  originDefinition   Json?               @map("origin_definition")
  sortOrder          Int                 @map("sort_order")
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdById        String?             @map("created_by_id") @db.Uuid
  updatedById        String?             @map("updated_by_id") @db.Uuid
  /// MOD-007 optimistic locking
  version            Int                 @default(1)
  createdAt          DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @map("updated_at") @db.Timestamptz(3)

  createdBy          User?               @relation("WorkflowRule_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User?               @relation("WorkflowRule_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  communications     Communication[]     @relation("Communication_rule")
  workflowExecutions WorkflowExecution[] @relation("WorkflowExecution_rule")
  tasks              Task[]              @relation("Task_rule")

  @@index([trigger])
  @@index([createdById])
  @@index([updatedById])
  @@map("workflow_rules")
}

/// 01-domaine/05 § 1.5 (triggerEventId: no FK, MOD-013 exception) — WorkflowExecution
model WorkflowExecution {
  id             String          @id @db.Uuid
  ruleId         String          @map("rule_id") @db.Uuid
  triggerEventId String          @map("trigger_event_id") @db.Uuid
  entityType     String          @map("entity_type") @db.VarChar(40)
  entityId       String          @map("entity_id") @db.Uuid
  scheduledFor   DateTime        @map("scheduled_for") @db.Timestamptz(3)
  executedAt     DateTime?       @map("executed_at") @db.Timestamptz(3)
  status         ExecutionStatus
  skipReason     String?         @map("skip_reason") @db.VarChar(200)
  error          String?         @db.VarChar(500)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime?       @map("next_attempt_at") @db.Timestamptz(3)
  actionsDone    Int             @default(0) @map("actions_done")
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(3)

  rule           WorkflowRule    @relation("WorkflowExecution_rule", fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([ruleId, triggerEventId])
  @@index([status, scheduledFor])
  @@index([status, nextAttemptAt])
  @@map("workflow_executions")
}

/// 01-domaine/05 § 1.6 — Task ⌫ ⟳
