/// 01-domaine/05 § 1.3 — Conversation
model Conversation {
  id                    String        @id @db.Uuid
  clientId              String        @map("client_id") @db.Uuid
  dossierId             String?       @map("dossier_id") @db.Uuid
  partnerOrganizationId String?       @map("partner_organization_id") @db.Uuid
  lastMessageAt         DateTime?     @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview    String?       @map("last_message_preview") @db.VarChar(160)
  /// cache
  unreadByClient        Int           @default(0) @map("unread_by_client")
  /// cache
  unreadByStaff         Int           @default(0) @map("unread_by_staff")
  clientEmailedAt       DateTime?     @map("client_emailed_at") @db.Timestamptz(3)
  staffEmailedAt        DateTime?     @map("staff_emailed_at") @db.Timestamptz(3)
  createdAt             DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @map("updated_at") @db.Timestamptz(3)

  client                Client        @relation("Conversation_client", fields: [clientId], references: [id], onDelete: Restrict)
