  lead           Lead       @relation("LeadFile_lead", fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy     User       @relation("LeadFile_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([uploadedById])
