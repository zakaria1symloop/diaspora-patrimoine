/// 01-domaine/04 § 1.1 — Client ⌫ ⟳
model Client {
  id                      String                   @id @db.Uuid
  userId                  String?                  @map("user_id") @db.Uuid
  email                   String?                  @db.Citext
  alternateEmails         String[]                 @default([]) @map("alternate_emails") @db.Citext
  emailDoubtful           Boolean                  @default(false) @map("email_doubtful")
  emailBouncedAt          DateTime?                @map("email_bounced_at") @db.Timestamptz(3)
  firstName               String?                  @map("first_name") @db.VarChar(80)
  lastName                String?                  @map("last_name") @db.VarChar(80)
  phone                   String?                  @db.VarChar(20)
  phoneCheckNeeded        Boolean                  @default(false) @map("phone_check_needed")
  whatsappOptIn           Boolean                  @default(false) @map("whatsapp_opt_in")
  preferredContactChannel ContactChannel?          @map("preferred_contact_channel")
  preferredContactSlot    ContactTimeSlot?         @map("preferred_contact_slot")
  timezone                String?                  @db.VarChar(64)
  countryOfResidence      String?                  @map("country_of_residence") @db.Char(2)
  cityOfResidence         String?                  @map("city_of_residence") @db.VarChar(80)
  nationalities           String[]                 @default([]) @db.Char(2)
  residencyStatus         ResidencyStatus?         @map("residency_status")
  /// sensitive (client.sensitive.read)
  birthDate               DateTime?                @map("birth_date") @db.Date
  preferredLanguage       Locale                   @default(fr) @map("preferred_language")
  profession              String?                  @db.VarChar(80)
  employmentType          EmploymentType?          @map("employment_type")
  employerName            String?                  @map("employer_name") @db.VarChar(120)
  employedSince           DateTime?                @map("employed_since") @db.Date
  /// sensitive
  monthlyIncome           Decimal?                 @map("monthly_income") @db.Decimal(12, 2)
  /// sensitive
  otherMonthlyIncome      Decimal?                 @map("other_monthly_income") @db.Decimal(12, 2)
  /// sensitive
  monthlyDebts            Decimal?                 @map("monthly_debts") @db.Decimal(12, 2)
  incomeCurrency          String?                  @map("income_currency") @db.Char(3)
  /// sensitive
  downPayment             Decimal?                 @map("down_payment") @db.Decimal(14, 2)
  downPaymentCurrency     String?                  @map("down_payment_currency") @db.Char(3)
  budgetMax               Decimal?                 @map("budget_max") @db.Decimal(14, 2)
  budgetCurrency          String?                  @map("budget_currency") @db.Char(3)
  budgetMonthly           Decimal?                 @map("budget_monthly") @db.Decimal(12, 2)
  budgetMonthlyCurrency   String?                  @map("budget_monthly_currency") @db.Char(3)
  preferredCountries      String[]                 @default([]) @map("preferred_countries") @db.Char(2)
  preferredRegionIds      String[]                 @default([]) @map("preferred_region_ids") @db.Uuid
  preferredTypes          PropertyType[]           @default([]) @map("preferred_types")
  minRooms                Int?                     @map("min_rooms")
  purchasePurpose         PurchasePurpose?         @map("purchase_purpose")
  purchaseTimeframe       PurchaseTimeframe?       @map("purchase_timeframe")
  financingPreference     FinancingPreference?     @map("financing_preference")
  source                  LeadSource?
  utm                     Json?
  /// cache (CYC-060)
  status                  ClientStatus             @default(PROSPECT)
  qualifiedAt             DateTime?                @map("qualified_at") @db.Timestamptz(3)
  qualifiedById           String?                  @map("qualified_by_id") @db.Uuid
  score                   Int?
  assignedAgentId         String?                  @map("assigned_agent_id") @db.Uuid
  /// cache
  marketingOptIn          Boolean                  @default(false) @map("marketing_opt_in")
  doNotContact            Boolean                  @default(false) @map("do_not_contact")
  doNotContactReason      String?                  @map("do_not_contact_reason") @db.VarChar(300)
  doNotContactAt          DateTime?                @map("do_not_contact_at") @db.Timestamptz(3)
  mergedIntoId            String?                  @map("merged_into_id") @db.Uuid
  notDuplicateOfIds       String[]                 @default([]) @map("not_duplicate_of_ids") @db.Uuid
  lastActivityAt          DateTime                 @map("last_activity_at") @db.Timestamptz(3)
  archivedAt              DateTime?                @map("archived_at") @db.Timestamptz(3)
  archivedReason          String?                  @map("archived_reason") @db.VarChar(300)
  restrictedAt            DateTime?                @map("restricted_at") @db.Timestamptz(3)
  restrictionReason       RestrictionReason?       @map("restriction_reason")
  gdprErasedAt            DateTime?                @map("gdpr_erased_at") @db.Timestamptz(3)
  /// Computed by the database (trigger clients_search_text, MOD-015/ARC-074): never written by the app
  searchText              String                   @default("") @map("search_text") @db.Text
  createdById             String?                  @map("created_by_id") @db.Uuid
  updatedById             String?                  @map("updated_by_id") @db.Uuid
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version                 Int                      @default(1)
  createdAt               DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @map("updated_at") @db.Timestamptz(3)

  user                    User?                    @relation("Client_user", fields: [userId], references: [id], onDelete: Restrict)
  residenceCountry        Country?                 @relation("Client_residenceCountry", fields: [countryOfResidence], references: [code], onDelete: Restrict)
  qualifiedBy             User?                    @relation("Client_qualifiedBy", fields: [qualifiedById], references: [id], onDelete: Restrict)
  assignedAgent           User?                    @relation("Client_assignedAgent", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  mergedInto              Client?                  @relation("Client_mergedInto", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  createdBy               User?                    @relation("Client_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User?                    @relation("Client_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  consents                Consent[]                @relation("Consent_client")
  mergedClients           Client[]                 @relation("Client_mergedInto")
  clientContacts          ClientContact[]          @relation("ClientContact_client")
  leads                   Lead[]                   @relation("Lead_client")
  favorites               Favorite[]               @relation("Favorite_client")
  searchAlerts            SearchAlert[]            @relation("SearchAlert_client")
  dossiers                Dossier[]                @relation("Dossier_client")
  dossierParties          DossierParty[]           @relation("DossierParty_client")
  reservations            Reservation[]            @relation("Reservation_client")
  appointments            Appointment[]            @relation("Appointment_client")
  simulations             Simulation[]             @relation("Simulation_client")
  communications          Communication[]          @relation("Communication_client")
  conversations           Conversation[]           @relation("Conversation_client")
  notificationPreferences NotificationPreference[] @relation("NotificationPreference_client")
  tasks                   Task[]                   @relation("Task_client")
  surveyInvitations       SurveyInvitation[]       @relation("SurveyInvitation_client")
  feedbacks               Feedback[]               @relation("Feedback_client")
  eventRegistrations      EventRegistration[]      @relation("EventRegistration_client")
  eventNotifyRequests     EventNotifyRequest[]     @relation("EventNotifyRequest_client")
  testimonials            Testimonial[]            @relation("Testimonial_client")
  dataRequests            DataRequest[]            @relation("DataRequest_client")

  @@index([phone])
  @@index([status, assignedAgentId])
  @@index([lastActivityAt])
  @@index([countryOfResidence])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([userId])
  @@index([qualifiedById])
  @@index([assignedAgentId])
  @@index([mergedIntoId])
  @@index([createdById])
  @@index([updatedById])
  @@map("clients")
}

/// 01-domaine/04 § 1.2 — ClientContact
model ClientContact {
  id                  String        @id @db.Uuid
  clientId            String        @map("client_id") @db.Uuid
  fullName            String        @map("full_name") @db.VarChar(160)
  relation            String?       @db.VarChar(60)
  phone               String?       @db.VarChar(20)
  email               String?       @db.Citext
  canVisitOnBehalf    Boolean       @default(false) @map("can_visit_on_behalf")
  notes               String?       @db.VarChar(300)
  informedConfirmedAt DateTime?     @map("informed_confirmed_at") @db.Timestamptz(3)
  createdById         String?       @map("created_by_id") @db.Uuid
  updatedById         String?       @map("updated_by_id") @db.Uuid
  createdAt           DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @map("updated_at") @db.Timestamptz(3)

  client              Client        @relation("ClientContact_client", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy           User?         @relation("ClientContact_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User?         @relation("ClientContact_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  appointments        Appointment[] @relation("Appointment_onBehalfContact")

  @@index([clientId])
  @@index([createdById])
  @@index([updatedById])
  @@map("client_contacts")
}

/// 01-domaine/04 § 1.3 — Lead
model Lead {
  id                     String                    @id @db.Uuid
  reference              String                    @unique @db.VarChar(20)
  kind                   LeadKind
  source                 LeadSource                @default(WEB_FORM)
  clientId               String?                   @map("client_id") @db.Uuid
  firstName              String?                   @map("first_name") @db.VarChar(80)
  lastName               String?                   @map("last_name") @db.VarChar(80)
  email                  String?                   @db.Citext
  phone                  String?                   @db.VarChar(20)
  propertyId             String?                   @map("property_id") @db.Uuid
  programId              String?                   @map("program_id") @db.Uuid
  lotId                  String?                   @map("lot_id") @db.Uuid
  simulationId           String?                   @map("simulation_id") @db.Uuid
  applicantUserId        String?                   @map("applicant_user_id") @db.Uuid
  partnerKind            PartnerDocumentOwner?     @map("partner_kind")
  applicationStatus      PartnerApplicationStatus? @map("application_status")
  application            Json?
  applicationSubmittedAt DateTime?                 @map("application_submitted_at") @db.Timestamptz(3)
  payload                Json
  message                String?                   @db.VarChar(2000)
  subject                ContactSubject?
  preferredCallbackDate  DateTime?                 @map("preferred_callback_date") @db.Date
  preferredSlot          ContactTimeSlot?          @map("preferred_slot")
  callerTimezone         String?                   @map("caller_timezone") @db.VarChar(64)
  supplements            Json?
  locale                 Locale
  utm                    Json?
  referrer               String?                   @db.VarChar(400)
  landingPath            String?                   @map("landing_path") @db.VarChar(400)
  submittedFromPath      String?                   @map("submitted_from_path") @db.VarChar(400)
  ipHash                 String?                   @map("ip_hash") @db.Char(64)
  userAgent              String?                   @map("user_agent") @db.VarChar(400)
  spamScore              Int                       @map("spam_score")
  spamSignals            Json                      @map("spam_signals")
  needsReview            Boolean                   @default(false) @map("needs_review")
  reviewedById           String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt             DateTime?                 @map("reviewed_at") @db.Timestamptz(3)
  completionTokenHash    String?                   @map("completion_token_hash") @db.Char(64)
  completionExpiresAt    DateTime?                 @map("completion_expires_at") @db.Timestamptz(3)
  status                 LeadStatus                @default(NEW)
  dossierId              String?                   @map("dossier_id") @db.Uuid
  contextDossierId       String?                   @map("context_dossier_id") @db.Uuid
  assignedAgentId        String?                   @map("assigned_agent_id") @db.Uuid
  takenAt                DateTime?                 @map("taken_at") @db.Timestamptz(3)
  firstContactAt         DateTime?                 @map("first_contact_at") @db.Timestamptz(3)
  slaDueAt               DateTime?                 @map("sla_due_at") @db.Timestamptz(3)
  slaBreachedAt          DateTime?                 @map("sla_breached_at") @db.Timestamptz(3)
  outcome                LeadOutcome?
  closedAt               DateTime?                 @map("closed_at") @db.Timestamptz(3)
  closedById             String?                   @map("closed_by_id") @db.Uuid
  closeNote              String?                   @map("close_note") @db.VarChar(500)
  createdById            String?                   @map("created_by_id") @db.Uuid
  updatedById            String?                   @map("updated_by_id") @db.Uuid
  createdAt              DateTime                  @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                  @map("updated_at") @db.Timestamptz(3)

  client                 Client?                   @relation("Lead_client", fields: [clientId], references: [id], onDelete: Restrict)
  property               Property?                 @relation("Lead_property", fields: [propertyId], references: [id], onDelete: Restrict)
  program                Program?                  @relation("Lead_program", fields: [programId], references: [id], onDelete: Restrict)
  lot                    Lot?                      @relation("Lead_lot", fields: [lotId], references: [id], onDelete: Restrict)
  simulation             Simulation?               @relation("Lead_simulation", fields: [simulationId], references: [id], onDelete: Restrict)
  applicantUser          User?                     @relation("Lead_applicantUser", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedBy             User?                     @relation("Lead_reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  dossier                Dossier?                  @relation("Lead_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  contextDossier         Dossier?                  @relation("Lead_contextDossier", fields: [contextDossierId], references: [id], onDelete: Restrict)
  assignedAgent          User?                     @relation("Lead_assignedAgent", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  closedBy               User?                     @relation("Lead_closedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdBy              User?                     @relation("Lead_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy              User?                     @relation("Lead_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  consents               Consent[]                 @relation("Consent_lead")
  leadFiles              LeadFile[]                @relation("LeadFile_lead")
  dossiers               Dossier[]                 @relation("Dossier_originLead")
  dossierCandidates      DossierCandidate[]        @relation("DossierCandidate_lead")
  simulations            Simulation[]              @relation("Simulation_lead")
  communications         Communication[]           @relation("Communication_lead")
  tasks                  Task[]                    @relation("Task_lead")

  @@index([status, createdAt])
  @@index([clientId])
  @@index([assignedAgentId])
  @@index([kind])
  @@index([dossierId])
  @@index([slaDueAt])
  @@index([propertyId])
  @@index([programId])
  @@index([lotId])
  @@index([simulationId])
  @@index([applicantUserId])
  @@index([reviewedById])
  @@index([contextDossierId])
  @@index([closedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("leads")
}

/// 01-domaine/04 § 1.3 bis — LeadFile ⌫
model LeadFile {
  id             String     @id @db.Uuid
  leadId         String     @map("lead_id") @db.Uuid
  section        String     @db.VarChar(30)
  label          String     @db.VarChar(160)
  storageKey     String     @map("storage_key") @db.VarChar(400)
  fileName       String     @map("file_name") @db.VarChar(200)
  mimeType       String     @map("mime_type") @db.VarChar(100)
  sizeBytes      Int        @map("size_bytes")
  checksumSha256 String     @map("checksum_sha256") @db.Char(64)
  scanStatus     ScanStatus @map("scan_status")
  uploadedById   String     @map("uploaded_by_id") @db.Uuid
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime   @map("created_at") @db.Timestamptz(3)
