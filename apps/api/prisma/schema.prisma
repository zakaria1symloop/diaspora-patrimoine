  createdById String?     @map("created_by_id") @db.Uuid
  updatedById String?     @map("updated_by_id") @db.Uuid
  createdAt   DateTime    @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @map("updated_at") @db.Timestamptz(3)

  program     Program?    @relation("PropertyPoi_program", fields: [programId], references: [id], onDelete: Cascade)
  property    Property?   @relation("PropertyPoi_property", fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("PropertyPoi_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("PropertyPoi_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([programId])
  @@index([propertyId])
  @@index([createdById])
  @@index([updatedById])
  @@map("property_pois")
}

/// 01-domaine/03 § 6 — ProgramUpdate ⌫
model ProgramUpdate {
