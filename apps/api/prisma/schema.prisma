  @@index([assigneeId, status, dueAt])
  @@index([dossierId])
  @@index([clientId])
  @@index([leadId])
  @@index([submissionId])
  @@index([eventId])
  @@index([propertyId])
  @@index([promoterId])
  @@index([bankId])
  @@index([bankProductId])
  @@index([appointmentId])
  @@index([reservationId])
  @@index([feedbackId])
  @@index([createdById])
  @@index([ruleId])
  @@index([completedById])
  @@index([updatedById])
  @@map("tasks")
}

/// 01-domaine/05 § 2.1 — Survey ⟳
model Survey {
  id                String             @id @db.Uuid
  code              String             @unique @db.VarChar(40)
  name              String             @db.VarChar(120)
  trigger           SurveyTrigger
  delayHours        Int                @map("delay_hours")
  intro             String?            @db.VarChar(400)
  originDefinition  Json?              @map("origin_definition")
  questions         Json
  isActive          Boolean            @map("is_active")
  createdById       String?            @map("created_by_id") @db.Uuid
  updatedById       String?            @map("updated_by_id") @db.Uuid
  /// MOD-007 optimistic locking
  version           Int                @default(1)
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @map("updated_at") @db.Timestamptz(3)

  createdBy         User?              @relation("Survey_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?              @relation("Survey_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  surveyInvitations SurveyInvitation[] @relation("SurveyInvitation_survey")
  feedbacks         Feedback[]         @relation("Feedback_survey")

  @@index([createdById])
  @@index([updatedById])
  @@map("surveys")
}

/// 01-domaine/05 § 2.2 — SurveyInvitation
model SurveyInvitation {
  id                String              @id @db.Uuid
  surveyId          String              @map("survey_id") @db.Uuid
  clientId          String              @map("client_id") @db.Uuid
  dossierId         String?             @map("dossier_id") @db.Uuid
  eventId           String?             @map("event_id") @db.Uuid
  tokenHash         String              @unique @map("token_hash") @db.Char(64)
  /// MOD-019: unique among filled values (PostgreSQL NULLs are distinct)
  reminderTokenHash String?             @unique @map("reminder_token_hash") @db.Char(64)
  scheduledFor      DateTime            @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  reminderSentAt    DateTime?           @map("reminder_sent_at") @db.Timestamptz(3)
  answeredAt        DateTime?           @map("answered_at") @db.Timestamptz(3)
  cancelledAt       DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      SurveyCancelReason? @map("cancel_reason")
  expiresAt         DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @map("updated_at") @db.Timestamptz(3)

  survey            Survey              @relation("SurveyInvitation_survey", fields: [surveyId], references: [id], onDelete: Restrict)
  client            Client              @relation("SurveyInvitation_client", fields: [clientId], references: [id], onDelete: Restrict)
  dossier           Dossier?            @relation("SurveyInvitation_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  event             Event?              @relation("SurveyInvitation_event", fields: [eventId], references: [id], onDelete: Restrict)

  feedbacks         Feedback[]          @relation("Feedback_invitation")

  @@index([scheduledFor])
  @@index([surveyId])
  @@index([clientId])
  @@index([dossierId])
  @@index([eventId])
  @@map("survey_invitations")
}

/// 01-domaine/05 § 2.3 — Feedback
model Feedback {
  id                   String            @id @db.Uuid
  kind                 FeedbackKind
  surveyId             String?           @map("survey_id") @db.Uuid
  invitationId         String?           @map("invitation_id") @db.Uuid
  clientId             String?           @map("client_id") @db.Uuid
  dossierId            String?           @map("dossier_id") @db.Uuid
  propertyId           String?           @map("property_id") @db.Uuid
  eventId              String?           @map("event_id") @db.Uuid
  promoterId           String?           @map("promoter_id") @db.Uuid
  bankId               String?           @map("bank_id") @db.Uuid
  authorOrganizationId String?           @map("author_organization_id") @db.Uuid
  stage                DossierStage?
  npsScore             Int?              @map("nps_score")
  csatScore            Int?              @map("csat_score")
  answers              Json?
  comment              String?           @db.VarChar(3000)
  category             FeedbackCategory?
  contactEmail         String?           @map("contact_email") @db.Citext
  listingErrorKind     ListingErrorKind? @map("listing_error_kind")
  status               FeedbackStatus    @default(NEW)
  handledById          String?           @map("handled_by_id") @db.Uuid
  handledAt            DateTime?         @map("handled_at") @db.Timestamptz(3)
  actionNote           String?           @map("action_note") @db.VarChar(1000)
  createdById          String?           @map("created_by_id") @db.Uuid
  updatedById          String?           @map("updated_by_id") @db.Uuid
  createdAt            DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @map("updated_at") @db.Timestamptz(3)

  survey               Survey?           @relation("Feedback_survey", fields: [surveyId], references: [id], onDelete: Restrict)
  invitation           SurveyInvitation? @relation("Feedback_invitation", fields: [invitationId], references: [id], onDelete: Restrict)
  client               Client?           @relation("Feedback_client", fields: [clientId], references: [id], onDelete: Restrict)
  dossier              Dossier?          @relation("Feedback_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  property             Property?         @relation("Feedback_property", fields: [propertyId], references: [id], onDelete: Restrict)
  event                Event?            @relation("Feedback_event", fields: [eventId], references: [id], onDelete: Restrict)
  promoter             Promoter?         @relation("Feedback_promoter", fields: [promoterId], references: [id], onDelete: Restrict)
  bank                 Bank?             @relation("Feedback_bank", fields: [bankId], references: [id], onDelete: Restrict)
  authorOrganization   Organization?     @relation("Feedback_authorOrganization", fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  handledBy            User?             @relation("Feedback_handledBy", fields: [handledById], references: [id], onDelete: Restrict)
  createdBy            User?             @relation("Feedback_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User?             @relation("Feedback_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  communications       Communication[]   @relation("Communication_feedback")
  tasks                Task[]            @relation("Task_feedback")

  @@index([status, createdAt])
  @@index([surveyId])
  @@index([dossierId])
  @@index([invitationId])
  @@index([clientId])
  @@index([propertyId])
  @@index([eventId])
  @@index([promoterId])
  @@index([bankId])
  @@index([authorOrganizationId])
  @@index([handledById])
  @@index([createdById])
  @@index([updatedById])
  @@map("feedbacks")
}

/// 01-domaine/05 § 3.1 — Event ⌫ ⟳
model Event {
  id                      String               @id @db.Uuid
  reference               String               @db.VarChar(24)
  slug                    String               @db.VarChar(80)
  title                   String               @db.VarChar(120)
  locationLabel           String               @map("location_label") @db.VarChar(80)
  cityName                String               @map("city_name") @db.VarChar(80)
  countryCode             String               @default("FR") @map("country_code") @db.Char(2)
  /// Registrants only (TRV-045)
  venueName               String?              @map("venue_name") @db.VarChar(160)
  venueAddress            String?              @map("venue_address") @db.VarChar(300)
  venueNotes              String?              @map("venue_notes") @db.VarChar(500)
  startsAt                DateTime             @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime             @map("ends_at") @db.Timestamptz(3)
  timezone                String               @default("Europe/Paris") @db.VarChar(64)
  capacity                Int
  maxSeatsPerRegistration Int                  @map("max_seats_per_registration")
  registrationOpensAt     DateTime?            @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt    DateTime             @map("registration_closes_at") @db.Timestamptz(3)
  description             String?              @db.VarChar(3000)
  coverMediaId            String?              @map("cover_media_id") @db.Uuid
  hostUserId              String?              @map("host_user_id") @db.Uuid
  status                  EventStatus          @default(DRAFT)
  publishedAt             DateTime?            @map("published_at") @db.Timestamptz(3)
  cancelledAt             DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelReason            String?              @map("cancel_reason") @db.VarChar(500)
  /// cache
  seatsTaken              Int                  @default(0) @map("seats_taken")
  /// cache
  waitlistSeats           Int                  @default(0) @map("waitlist_seats")
  /// cache
  attendedSeats           Int                  @default(0) @map("attended_seats")
  walkInSeats             Int                  @default(0) @map("walk_in_seats")
  createdById             String?              @map("created_by_id") @db.Uuid
  updatedById             String?              @map("updated_by_id") @db.Uuid
  deletedAt               DateTime?            @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version                 Int                  @default(1)
  createdAt               DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @map("updated_at") @db.Timestamptz(3)

  coverMedia              Media?               @relation("Event_coverMedia", fields: [coverMediaId], references: [id], onDelete: Restrict)
  hostUser                User?                @relation("Event_hostUser", fields: [hostUserId], references: [id], onDelete: Restrict)
  createdBy               User?                @relation("Event_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User?                @relation("Event_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  communications          Communication[]      @relation("Communication_event")
  tasks                   Task[]               @relation("Task_event")
  surveyInvitations       SurveyInvitation[]   @relation("SurveyInvitation_event")
  feedbacks               Feedback[]           @relation("Feedback_event")
  eventPartners           EventPartner[]       @relation("EventPartner_event")
  eventRegistrations      EventRegistration[]  @relation("EventRegistration_event")
  eventNotifyRequests     EventNotifyRequest[] @relation("EventNotifyRequest_event")

  @@index([coverMediaId])
  @@index([hostUserId])
  @@index([createdById])
  @@index([updatedById])
  @@map("events")
}

/// 01-domaine/05 § 3.2 — EventPartner
model EventPartner {
  id          String    @id @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  promoterId  String?   @map("promoter_id") @db.Uuid
  bankId      String?   @map("bank_id") @db.Uuid
  partnerId   String?   @map("partner_id") @db.Uuid
  roleLabel   String?   @map("role_label") @db.VarChar(80)
  contactName String?   @map("contact_name") @db.VarChar(160)
