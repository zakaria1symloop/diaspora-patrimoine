/// 01-domaine/05 § 1.1 (deletedAt: soft delete of M_ templates, COM-053) — EmailTemplate ⌫ ⟳
model EmailTemplate {
  id                    String                 @id @db.Uuid
  code                  String                 @db.VarChar(60)
  locale                Locale
  audience              EmailAudience
  category              EmailTemplateCategory
  name                  String                 @db.VarChar(120)
  description           String?                @db.VarChar(300)
  subject               String                 @db.VarChar(200)
  preheader             String?                @db.VarChar(160)
  bodyHtml              String                 @map("body_html") @db.Text
  bodyText              String?                @map("body_text") @db.Text
  variables             String[]               @default([]) @db.VarChar(60)
  requiredVariables     String[]               @default([]) @map("required_variables") @db.VarChar(60)
  secretVariables       String[]               @default([]) @map("secret_variables") @db.VarChar(60)
  preferenceGroup       String?                @map("preference_group") @db.VarChar(40)
  originSubject         String?                @map("origin_subject") @db.Text
  originPreheader       String?                @map("origin_preheader") @db.Text
  originBodyHtml        String?                @map("origin_body_html") @db.Text
  isSystem              Boolean                @map("is_system")
  isActive              Boolean                @map("is_active")
  sentBy                TriggerKind[]          @default([]) @map("sent_by")
  createdById           String?                @map("created_by_id") @db.Uuid
  updatedById           String?                @map("updated_by_id") @db.Uuid
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(3)
  /// MOD-007 optimistic locking
  version               Int                    @default(1)
  createdAt             DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @map("updated_at") @db.Timestamptz(3)

  createdBy             User?                  @relation("EmailTemplate_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User?                  @relation("EmailTemplate_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  emailTemplateVersions EmailTemplateVersion[] @relation("EmailTemplateVersion_template")

  @@index([createdById])
  @@index([updatedById])
  @@map("email_templates")
}

/// 01-domaine/05 § 1.1 (immutable) — EmailTemplateVersion
model EmailTemplateVersion {
  id          String        @id @db.Uuid
  templateId  String        @map("template_id") @db.Uuid
  version     Int
  subject     String        @db.VarChar(200)
  preheader   String?       @db.VarChar(160)
  bodyHtml    String        @map("body_html") @db.Text
  updatedById String?       @map("updated_by_id") @db.Uuid
