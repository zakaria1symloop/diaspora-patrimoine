// ──────────────────────────────────────────────────────────────────────────
// 05-phases-ulterieures/04 — Assistant conversationnel (IA-005, IA-013; D-090: Phase 1)
// ──────────────────────────────────────────────────────────────────────────

/// IA-013 — a conversation of the search assistant in mode AI (ASS-052). Kept 30 days for quality control, without
/// any link to an identity (no client, no IP, no session): the visitor's texts are stored with personal data masked.
/// When the visitor leaves contact details, the summary is copied into the request (`Lead.payload`), not linked here.
model AssistantConversation {
  id                 String    @id @db.Uuid
  /// provider and model that answered (ENV-040 `AI_PROVIDER`, `AI_MODEL`)
  provider           String    @db.VarChar(40)
  model              String    @db.VarChar(80)
  /// [{role: 'visitor'|'assistant', text, at}] — texts only (no tool call), personal data masked
  messages           Json      @default("[]")
  /// the criteria understood, validated (CAT-020 keys)
  criteria           Json      @default("{}")
  /// the properties shown, twenty references at most (ASS-030)
  propertyReferences String[]  @default([]) @map("property_references")
  handoffReason      String?   @map("handoff_reason") @db.VarChar(40)
  visitorTurns       Int       @default(0) @map("visitor_turns")
  inputTokens        Int       @default(0) @map("input_tokens")
  outputTokens       Int       @default(0) @map("output_tokens")
  /// cost of the model calls in millionths of euro (IA-005)
  costMicros         BigInt    @default(0) @map("cost_micros")
  /// a quality signal raised by the server (invalid model output, figure not from the data…), never shown
  flags              String[]  @default([])
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("assistant_conversations")
}

/// IA-005, PAR (`ai.assistant.monthlyBudget`) — spend of one AI usage in one month of the business calendar.
model AiUsageMonth {
  usage        String    @db.VarChar(40)
  /// YYYY-MM
  month        String    @db.Char(7)
  calls        Int       @default(0)
  inputTokens  BigInt    @default(0) @map("input_tokens")
  outputTokens BigInt    @default(0) @map("output_tokens")
  costMicros   BigInt    @default(0) @map("cost_micros")
  /// AUT-076 — when the technical alert of the cap was raised (once a month)
  alertedAt    DateTime? @map("alerted_at") @db.Timestamptz(3)
  updatedAt    DateTime  @map("updated_at") @db.Timestamptz(3)

  @@id([usage, month])
  @@map("ai_usage_months")
}

