  clientId        String             @map("client_id") @db.Uuid
  firstName       String             @map("first_name") @db.VarChar(80)
  lastName        String             @map("last_name") @db.VarChar(80)
  email           String             @db.Citext
  phone           String?            @db.VarChar(20)
  seats           Int
  status          RegistrationStatus
  questions       String?            @db.VarChar(1000)
  topics          EventTopic[]       @default([])
  source          LeadSource
  manageTokenHash String             @unique @map("manage_token_hash") @db.Char(64)
  checkInCode     String             @map("check_in_code") @db.VarChar(8)
  registeredAt    DateTime           @map("registered_at") @db.Timestamptz(3)
  promotedAt      DateTime?          @map("promoted_at") @db.Timestamptz(3)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     CancelledBy?       @map("cancelled_by")
  cancelReason    String?            @map("cancel_reason") @db.VarChar(300)
  attendedAt      DateTime?          @map("attended_at") @db.Timestamptz(3)
  checkedInById   String?            @map("checked_in_by_id") @db.Uuid
  reminder7SentAt DateTime?          @map("reminder7_sent_at") @db.Timestamptz(3)
  reminder1SentAt DateTime?          @map("reminder1_sent_at") @db.Timestamptz(3)
  followUpSentAt  DateTime?          @map("follow_up_sent_at") @db.Timestamptz(3)
  utm             Json?
  locale          Locale
  createdById     String?            @map("created_by_id") @db.Uuid
  updatedById     String?            @map("updated_by_id") @db.Uuid
  /// MOD-007 optimistic locking
  version         Int                @default(1)
  createdAt       DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @map("updated_at") @db.Timestamptz(3)

  event           Event              @relation("EventRegistration_event", fields: [eventId], references: [id], onDelete: Restrict)
  client          Client             @relation("EventRegistration_client", fields: [clientId], references: [id], onDelete: Restrict)
  checkedInBy     User?              @relation("EventRegistration_checkedInBy", fields: [checkedInById], references: [id], onDelete: Restrict)
  createdBy       User?              @relation("EventRegistration_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?              @relation("EventRegistration_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  consents        Consent[]          @relation("Consent_registration")
  communications  Communication[]    @relation("Communication_registration")

  @@unique([eventId, checkInCode])
  @@index([clientId])
  @@index([checkedInById])
  @@index([createdById])
  @@index([updatedById])
  @@map("event_registrations")
}

/// 01-domaine/05 § 3.4 — EventNotifyRequest
model EventNotifyRequest {
  id                   String    @id @db.Uuid
  email                String    @db.Citext
  eventId              String?   @map("event_id") @db.Uuid
  locationLabel        String?   @map("location_label") @db.VarChar(80)
