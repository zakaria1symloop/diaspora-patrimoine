model ChecklistItem {
  id               String            @id @db.Uuid
  templateId       String            @map("template_id") @db.Uuid
  addedInVersion   Int               @map("added_in_version")
  retiredInVersion Int?              @map("retired_in_version")
  code             String            @db.VarChar(60)
  label            String            @db.VarChar(160)
  labelWhenCash    String?           @map("label_when_cash") @db.VarChar(160)
  description      String?           @db.VarChar(600)
  category         DocumentCategory
  isRequired       Boolean           @default(true) @map("is_required")
  perParty         Boolean           @default(false) @map("per_party")
  appliesToRoles   PartyRole[]       @default([PRIMARY, CO_BORROWER]) @map("applies_to_roles")
  appliesWhen      Json?             @map("applies_when")
  providedBy       DocumentProvider  @default(CLIENT) @map("provided_by")
  maxFiles         Int               @default(5) @map("max_files")
  acceptedFormats  String[]          @default(["pdf", "jpg", "jpeg", "png", "heic"]) @map("accepted_formats") @db.VarChar(10)
  validityDays     Int?              @map("validity_days")
  exampleMediaId   String?           @map("example_media_id") @db.Uuid
  sortOrder        Int               @map("sort_order")
  createdById      String?           @map("created_by_id") @db.Uuid
  updatedById      String?           @map("updated_by_id") @db.Uuid
  createdAt        DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @map("updated_at") @db.Timestamptz(3)

  template         ChecklistTemplate @relation("ChecklistItem_template", fields: [templateId], references: [id], onDelete: Cascade)
  exampleMedia     Media?            @relation("ChecklistItem_exampleMedia", fields: [exampleMediaId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("ChecklistItem_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?             @relation("ChecklistItem_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  dossierDocuments DossierDocument[] @relation("DossierDocument_checklistItem")

  @@index([templateId])
  @@index([exampleMediaId])
  @@index([createdById])
  @@index([updatedById])
  @@map("checklist_items")
}

/// 01-domaine/04 § 3.3 — DossierDocument ⟳
model DossierDocument {
  id                                       String               @id @db.Uuid
  dossierId                                String               @map("dossier_id") @db.Uuid
  partyId                                  String?              @map("party_id") @db.Uuid
  checklistItemId                          String?              @map("checklist_item_id") @db.Uuid
  code                                     String?              @db.VarChar(60)
  label                                    String               @db.VarChar(160)
  labelEdited                              Boolean              @default(false) @map("label_edited")
  description                              String?              @db.VarChar(600)
  category                                 DocumentCategory
  isRequired                               Boolean              @map("is_required")
  providedBy                               DocumentProvider     @map("provided_by")
  source                                   DocumentSource
  submissionId                             String?              @map("submission_id") @db.Uuid
  isInternal                               Boolean              @default(false) @map("is_internal")
  maxFiles                                 Int                  @map("max_files")
  acceptedFormats                          String[]             @default([]) @map("accepted_formats") @db.VarChar(10)
  validityDays                             Int?                 @map("validity_days")
  status                                   DocumentStatus       @default(PENDING)
  statusChangedAt                          DateTime             @map("status_changed_at") @db.Timestamptz(3)
  dueAt                                    DateTime?            @map("due_at") @db.Date
  reminderCount                            Int                  @default(0) @map("reminder_count")
  reminderBaseAt                           DateTime?            @map("reminder_base_at") @db.Timestamptz(3)
  lastRemindedAt                           DateTime?            @map("last_reminded_at") @db.Timestamptz(3)
  remindersPaused                          Boolean              @default(false) @map("reminders_paused")
  currentVersion                           Int                  @default(0) @map("current_version")
  renewalVersion                           Int?                 @map("renewal_version")
  transmittedVersion                       Int?                 @map("transmitted_version")
  rejectionReason                          RejectionReason?     @map("rejection_reason")
  rejectionNote                            String?              @map("rejection_note") @db.VarChar(500)
  validatedById                            String?              @map("validated_by_id") @db.Uuid
  validatedAt                              DateTime?            @map("validated_at") @db.Timestamptz(3)
  issuedAt                                 DateTime?            @map("issued_at") @db.Date
  expiresAt                                DateTime?            @map("expires_at") @db.Date
  waivedById                               String?              @map("waived_by_id") @db.Uuid
  waiveReason                              String?              @map("waive_reason") @db.VarChar(300)
  waiveKind                                WaiveKind?           @map("waive_kind")
  createdById                              String?              @map("created_by_id") @db.Uuid
  updatedById                              String?              @map("updated_by_id") @db.Uuid
  /// MOD-007 optimistic locking
  version                                  Int                  @default(1)
  createdAt                                DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt                                DateTime             @map("updated_at") @db.Timestamptz(3)

  dossier                                  Dossier              @relation("DossierDocument_dossier", fields: [dossierId], references: [id], onDelete: Cascade)
  party                                    DossierParty?        @relation("DossierDocument_party", fields: [partyId], references: [id], onDelete: Cascade)
  checklistItem                            ChecklistItem?       @relation("DossierDocument_checklistItem", fields: [checklistItemId], references: [id], onDelete: Restrict)
  submission                               BankSubmission?      @relation("DossierDocument_submission", fields: [submissionId], references: [id], onDelete: Restrict)
  validatedBy                              User?                @relation("DossierDocument_validatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  waivedBy                                 User?                @relation("DossierDocument_waivedBy", fields: [waivedById], references: [id], onDelete: Restrict)
  createdBy                                User?                @relation("DossierDocument_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                                User?                @relation("DossierDocument_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  consents                                 Consent[]            @relation("Consent_proofDocument")
  reservationsAsDepositProofDocument       Reservation[]        @relation("Reservation_depositProofDocument")
  reservationsAsDepositRefundProofDocument Reservation[]        @relation("Reservation_depositRefundProofDocument")
  reservationsAsContractDocument           Reservation[]        @relation("Reservation_contractDocument")
  documentVersions                         DocumentVersion[]    @relation("DocumentVersion_document")
  documentFiles                            DocumentFile[]       @relation("DocumentFile_document")
  bankSubmissions                          BankSubmission[]     @relation("BankSubmission_offerDocument")
  submissionDocuments                      SubmissionDocument[] @relation("SubmissionDocument_dossierDocument")
  messageAttachments                       MessageAttachment[]  @relation("MessageAttachment_filedAsDocument")

  @@index([dossierId, status])
  @@index([status, dueAt])
  @@index([expiresAt])
  @@index([partyId])
  @@index([checklistItemId])
  @@index([submissionId])
  @@index([validatedById])
  @@index([waivedById])
  @@index([createdById])
  @@index([updatedById])
  @@map("dossier_documents")
}

/// 01-domaine/04 § 3.4 (deletedAt marks a state, outside MOD-006) — DocumentVersion
model DocumentVersion {
  id              String           @id @db.Uuid
  documentId      String           @map("document_id") @db.Uuid
  number          Int
  uploadedById    String?          @map("uploaded_by_id") @db.Uuid
  uploadedVia     UploadChannel    @map("uploaded_via")
  uploadedAt      DateTime         @map("uploaded_at") @db.Timestamptz(3)
  outcome         VersionOutcome   @default(SCANNING)
  isRenewal       Boolean          @map("is_renewal")
  decidedById     String?          @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at") @db.Timestamptz(3)
  rejectionReason RejectionReason? @map("rejection_reason")
  rejectionNote   String?          @map("rejection_note") @db.VarChar(500)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedById     String?          @map("deleted_by_id") @db.Uuid
  deleteReason    String?          @map("delete_reason") @db.VarChar(300)
  filesPurgedAt   DateTime?        @map("files_purged_at") @db.Timestamptz(3)
  createdAt       DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @map("updated_at") @db.Timestamptz(3)

  document        DossierDocument  @relation("DocumentVersion_document", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User?            @relation("DocumentVersion_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  decidedBy       User?            @relation("DocumentVersion_decidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  deletedBy       User?            @relation("DocumentVersion_deletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  documentFiles   DocumentFile[]   @relation("DocumentFile_version")

  @@unique([documentId, number])
  @@index([uploadedById])
  @@index([decidedById])
  @@index([deletedById])
  @@map("document_versions")
}

/// 01-domaine/04 § 3.5 — DocumentFile ⌫
model DocumentFile {
  id                  String          @id @db.Uuid
  versionId           String          @map("version_id") @db.Uuid
  documentId          String          @map("document_id") @db.Uuid
  sortOrder           Int             @map("sort_order")
  storageKey          String          @map("storage_key") @db.VarChar(400)
  fileName            String          @map("file_name") @db.VarChar(200)
  mimeType            String          @map("mime_type") @db.VarChar(100)
  sizeBytes           BigInt          @map("size_bytes")
  checksumSha256      String          @map("checksum_sha256") @db.Char(64)
  pageCount           Int?            @map("page_count")
  assembledFromImages Int?            @map("assembled_from_images")
  scanStatus          ScanStatus      @default(PENDING) @map("scan_status")
  scanCheckedAt       DateTime?       @map("scan_checked_at") @db.Timestamptz(3)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @map("updated_at") @db.Timestamptz(3)

  version             DocumentVersion @relation("DocumentFile_version", fields: [versionId], references: [id], onDelete: Cascade)
  document            DossierDocument @relation("DocumentFile_document", fields: [documentId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([documentId])
  @@map("document_files")
}

/// 01-domaine/04 § 3.6 — DocumentReminder
model DocumentReminder {
  id                 String         @id @db.Uuid
  dossierId          String         @map("dossier_id") @db.Uuid
  remindedAt         DateTime       @map("reminded_at") @db.Timestamptz(3)
  isManual           Boolean        @map("is_manual")
  triggeredById      String?        @map("triggered_by_id") @db.Uuid
  documentIds        String[]       @default([]) @map("document_ids") @db.Uuid
  countedDocumentIds String[]       @default([]) @map("counted_document_ids") @db.Uuid
  communicationId    String?        @map("communication_id") @db.Uuid
  skipReason         String?        @map("skip_reason") @db.VarChar(100)
  createdAt          DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @map("updated_at") @db.Timestamptz(3)

  dossier            Dossier        @relation("DocumentReminder_dossier", fields: [dossierId], references: [id], onDelete: Cascade)
  triggeredBy        User?          @relation("DocumentReminder_triggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)
  communication      Communication? @relation("DocumentReminder_communication", fields: [communicationId], references: [id], onDelete: Restrict)

  @@index([dossierId, remindedAt])
  @@index([triggeredById])
  @@index([communicationId])
  @@map("document_reminders")
}

/// 01-domaine/04 § 4.1 — BankSubmission ⟳
model BankSubmission {
  id                       String                @id @db.Uuid
  reference                String                @unique @db.VarChar(20)
  dossierId                String                @map("dossier_id") @db.Uuid
  bankId                   String                @map("bank_id") @db.Uuid
  bankProductId            String?               @map("bank_product_id") @db.Uuid
  financingType            FinancingType         @map("financing_type")
  status                   SubmissionStatus      @default(DRAFT)
  transmissionMode         TransmissionMode      @map("transmission_mode")
  recipientContactId       String?               @map("recipient_contact_id") @db.Uuid
  recipientEmail           String?               @map("recipient_email") @db.Citext
  requestedAmount          Decimal               @map("requested_amount") @db.Decimal(14, 2)
  currency                 String                @db.Char(3)
  requestedDurationMonths  Int                   @map("requested_duration_months")
  submittedById            String?               @map("submitted_by_id") @db.Uuid
  submittedAt              DateTime?             @map("submitted_at") @db.Timestamptz(3)
  manualTransmissionMeans  String?               @map("manual_transmission_means") @db.VarChar(120)
  bankReference            String?               @map("bank_reference") @db.VarChar(60)
  expectedDecisionAt       DateTime?             @map("expected_decision_at") @db.Date
  followUpCount            Int                   @default(0) @map("follow_up_count")
  lastFollowUpAt           DateTime?             @map("last_follow_up_at") @db.Timestamptz(3)
  infoRequestedAt          DateTime?             @map("info_requested_at") @db.Timestamptz(3)
  /// Shown to the client
  infoRequestNote          String?               @map("info_request_note") @db.VarChar(4000)
  decisionAt               DateTime?             @map("decision_at") @db.Timestamptz(3)
  decisionPublishedAt      DateTime?             @map("decision_published_at") @db.Timestamptz(3)
  approvedAmount           Decimal?              @map("approved_amount") @db.Decimal(14, 2)
  approvedRateBps          Int?                  @map("approved_rate_bps")
  approvedDurationMonths   Int?                  @map("approved_duration_months")
  approvedPricingMethod    PricingMethod?        @map("approved_pricing_method")
  approvedInsuranceRateBps Int?                  @map("approved_insurance_rate_bps")
  approvedFileFees         Decimal?              @map("approved_file_fees") @db.Decimal(14, 2)
  monthlyPayment           Decimal?              @map("monthly_payment") @db.Decimal(14, 2)
  offerValidUntil          DateTime?             @map("offer_valid_until") @db.Date
  acceptRequestedAt        DateTime?             @map("accept_requested_at") @db.Timestamptz(3)
  conditions               String?               @db.VarChar(2000)
  offerDocumentId          String?               @map("offer_document_id") @db.Uuid
  rejectionReason          String?               @map("rejection_reason") @db.VarChar(500)
  shareRejectionReason     Boolean               @default(false) @map("share_rejection_reason")
  /// Internal
  decisionNotes            String?               @map("decision_notes") @db.VarChar(2000)
  acceptedByClientAt       DateTime?             @map("accepted_by_client_at") @db.Timestamptz(3)
  declinedByClientAt       DateTime?             @map("declined_by_client_at") @db.Timestamptz(3)
  withdrawnAt              DateTime?             @map("withdrawn_at") @db.Timestamptz(3)
  withdrawReason           String?               @map("withdraw_reason") @db.VarChar(300)
  createdById              String?               @map("created_by_id") @db.Uuid
  updatedById              String?               @map("updated_by_id") @db.Uuid
  /// MOD-007 optimistic locking
  version                  Int                   @default(1)
  createdAt                DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime              @map("updated_at") @db.Timestamptz(3)

  dossier                  Dossier               @relation("BankSubmission_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  bank                     Bank                  @relation("BankSubmission_bank", fields: [bankId], references: [id], onDelete: Restrict)
  bankProduct              BankProduct?          @relation("BankSubmission_bankProduct", fields: [bankProductId], references: [id], onDelete: Restrict)
  recipientContact         BankContact?          @relation("BankSubmission_recipientContact", fields: [recipientContactId], references: [id], onDelete: Restrict)
  submittedBy              User?                 @relation("BankSubmission_submittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  offerDocument            DossierDocument?      @relation("BankSubmission_offerDocument", fields: [offerDocumentId], references: [id], onDelete: Restrict)
  createdBy                User?                 @relation("BankSubmission_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User?                 @relation("BankSubmission_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  dossiers                 Dossier[]             @relation("Dossier_acceptedSubmission")
  dossierDocuments         DossierDocument[]     @relation("DossierDocument_submission")
  submissionDocuments      SubmissionDocument[]  @relation("SubmissionDocument_submission")
  submissionPackages       SubmissionPackage[]   @relation("SubmissionPackage_submission")
  bankSubmissionEvents     BankSubmissionEvent[] @relation("BankSubmissionEvent_submission")
  communications           Communication[]       @relation("Communication_submission")
  tasks                    Task[]                @relation("Task_submission")

  @@index([bankId, status])
  @@index([dossierId])
  @@index([expectedDecisionAt])
  @@index([bankProductId])
  @@index([recipientContactId])
  @@index([submittedById])
  @@index([offerDocumentId])
  @@index([createdById])
  @@index([updatedById])
  @@map("bank_submissions")
}

/// 01-domaine/04 § 4.2 — SubmissionDocument
model SubmissionDocument {
  id                String          @id @db.Uuid
  submissionId      String          @map("submission_id") @db.Uuid
  dossierDocumentId String          @map("dossier_document_id") @db.Uuid
  checklistItemCode String?         @map("checklist_item_code") @db.VarChar(60)
  isIncluded        Boolean         @map("is_included")
  includedVersion   Int?            @map("included_version")
  createdById       String?         @map("created_by_id") @db.Uuid
  updatedById       String?         @map("updated_by_id") @db.Uuid
  createdAt         DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @map("updated_at") @db.Timestamptz(3)

  submission        BankSubmission  @relation("SubmissionDocument_submission", fields: [submissionId], references: [id], onDelete: Cascade)
  dossierDocument   DossierDocument @relation("SubmissionDocument_dossierDocument", fields: [dossierDocumentId], references: [id], onDelete: Restrict)
  createdBy         User?           @relation("SubmissionDocument_createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?           @relation("SubmissionDocument_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([submissionId, dossierDocumentId])
  @@index([dossierDocumentId])
  @@index([createdById])
  @@index([updatedById])
  @@map("submission_documents")
}

/// 01-domaine/04 § 4.3 — SubmissionPackage
model SubmissionPackage {
  id                String         @id @db.Uuid
  submissionId      String         @map("submission_id") @db.Uuid
  storageKey        String         @map("storage_key") @db.VarChar(400)
  summaryStorageKey String         @map("summary_storage_key") @db.VarChar(400)
  isComplement      Boolean        @default(false) @map("is_complement")
  manifest          Json
  sizeBytes         BigInt         @map("size_bytes")
  checksumSha256    String         @map("checksum_sha256") @db.Char(64)
  generatedById     String         @map("generated_by_id") @db.Uuid
  generatedAt       DateTime       @map("generated_at") @db.Timestamptz(3)
  purgeAt           DateTime       @map("purge_at") @db.Timestamptz(3)
  createdAt         DateTime       @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @map("updated_at") @db.Timestamptz(3)

  submission        BankSubmission @relation("SubmissionPackage_submission", fields: [submissionId], references: [id], onDelete: Restrict)
  generatedBy       User           @relation("SubmissionPackage_generatedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  secureShares      SecureShare[]  @relation("SecureShare_package")

  @@index([submissionId])
  @@index([generatedById])
  @@map("submission_packages")
}

/// 01-domaine/04 § 4.3 (entityId: polymorphic, no FK) — SecureShare
model SecureShare {
  id                 String             @id @db.Uuid
  purpose            SharePurpose
  packageId          String?            @map("package_id") @db.Uuid
  exportJobId        String?            @map("export_job_id") @db.Uuid
  organizationId     String?            @map("organization_id") @db.Uuid
  entityType         String?            @map("entity_type") @db.VarChar(40)
  entityId           String?            @map("entity_id") @db.Uuid
  gestures           PartnerGesture[]   @default([])
  answerUntil        DateTime?          @map("answer_until") @db.Timestamptz(3)
  remindedAt         DateTime?          @map("reminded_at") @db.Timestamptz(3)
  tokenHash          String             @unique @map("token_hash") @db.Char(64)
  recipientEmail     String             @map("recipient_email") @db.Citext
  recipientName      String?            @map("recipient_name") @db.VarChar(160)
  /// Argon2id hash, never encrypted (MOD-016)
  accessCodeHash     String             @map("access_code_hash") @db.Text
  expiresAt          DateTime           @map("expires_at") @db.Timestamptz(3)
  maxDownloads       Int                @default(5) @map("max_downloads")
  downloadCount      Int                @default(0) @map("download_count")
  failedCodeAttempts Int                @default(0) @map("failed_code_attempts")
  lockedAt           DateTime?          @map("locked_at") @db.Timestamptz(3)
  revokedAt          DateTime?          @map("revoked_at") @db.Timestamptz(3)
  lastAccessAt       DateTime?          @map("last_access_at") @db.Timestamptz(3)
  revokedById        String?            @map("revoked_by_id") @db.Uuid
  createdById        String             @map("created_by_id") @db.Uuid
  createdAt          DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @map("updated_at") @db.Timestamptz(3)

  package            SubmissionPackage? @relation("SecureShare_package", fields: [packageId], references: [id], onDelete: Restrict)
  exportJob          ExportJob?         @relation("SecureShare_exportJob", fields: [exportJobId], references: [id], onDelete: Restrict)
  organization       Organization?      @relation("SecureShare_organization", fields: [organizationId], references: [id], onDelete: Restrict)
  revokedBy          User?              @relation("SecureShare_revokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdBy          User               @relation("SecureShare_createdBy", fields: [createdById], references: [id], onDelete: Restrict)

  partnerAnswers     PartnerAnswer[]    @relation("PartnerAnswer_secureShare")

  @@index([entityType, entityId])
  @@index([packageId])
  @@index([exportJobId])
  @@index([organizationId])
  @@index([revokedById])
  @@index([createdById])
  @@map("secure_shares")
}

/// 01-domaine/04 § 4.4 (immutable) — BankSubmissionEvent
model BankSubmissionEvent {
  id           String              @id @db.Uuid
  submissionId String              @map("submission_id") @db.Uuid
  type         SubmissionEventType
  fromStatus   SubmissionStatus?   @map("from_status")
  toStatus     SubmissionStatus?   @map("to_status")
  note         String?             @db.VarChar(2000)
  actorType    ActorType           @map("actor_type")
  actorId      String?             @map("actor_id") @db.Uuid
  reportedBy   String?             @map("reported_by") @db.VarChar(160)
  route        GestureRoute?
  metadata     Json?
  createdAt    DateTime            @map("created_at") @db.Timestamptz(3)

  submission   BankSubmission      @relation("BankSubmissionEvent_submission", fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?               @relation("BankSubmissionEvent_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([actorId])
  @@map("bank_submission_events")
}

/// 01-domaine/04 § 4.5 (inputs, outputs, parametersSnapshot immutable: MOD-370) — Simulation
model Simulation {
  id                 String          @id @db.Uuid
  type               SimulationType
  clientId           String?         @map("client_id") @db.Uuid
  dossierId          String?         @map("dossier_id") @db.Uuid
  leadId             String?         @map("lead_id") @db.Uuid
  propertyId         String?         @map("property_id") @db.Uuid
  lotId              String?         @map("lot_id") @db.Uuid
  bankProductId      String?         @map("bank_product_id") @db.Uuid
  anonymousId        String?         @map("anonymous_id") @db.VarChar(64)
  label              String?         @db.VarChar(120)
  inputs             Json
  outputs            Json
  parametersSnapshot Json            @map("parameters_snapshot")
  isSaved            Boolean         @default(false) @map("is_saved")
  createdById        String?         @map("created_by_id") @db.Uuid
  sentAt             DateTime?       @map("sent_at") @db.Timestamptz(3)
  pdfStorageKey      String?         @map("pdf_storage_key") @db.VarChar(400)
  locale             Locale
  createdAt          DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @map("updated_at") @db.Timestamptz(3)

  client             Client?         @relation("Simulation_client", fields: [clientId], references: [id], onDelete: Restrict)
  dossier            Dossier?        @relation("Simulation_dossier", fields: [dossierId], references: [id], onDelete: Restrict)
  lead               Lead?           @relation("Simulation_lead", fields: [leadId], references: [id], onDelete: Restrict)
  property           Property?       @relation("Simulation_property", fields: [propertyId], references: [id], onDelete: Restrict)
  lot                Lot?            @relation("Simulation_lot", fields: [lotId], references: [id], onDelete: Restrict)
  bankProduct        BankProduct?    @relation("Simulation_bankProduct", fields: [bankProductId], references: [id], onDelete: Restrict)
  createdBy          User?           @relation("Simulation_createdBy", fields: [createdById], references: [id], onDelete: Restrict)

