# ENV-040 — copy to .env. Never commit .env.
APP_ENV=local
APP_ROLE=api
PORT=4000
DATABASE_URL=postgresql://dp:dp-local@localhost:5433/diaspora
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
REVALIDATE_SECRET=change-me-local-revalidate-secret-32chars
SESSION_SECRET=change-me-local-session-secret-at-least-32
# SITE_GATE_PASSWORD=   (NAV-064: when set, the site is closed behind the waiting page)
JWT_SIGNING_KEY=change-me-32-chars-minimum-random-value
IP_HASH_KEY=change-me-32-chars-minimum-random-value
LINK_SIGNING_KEY=change-me-32-chars-minimum-random-value
# SEC-085, MOD-016 — AES-256-GCM key of the two-factor secret (32 random bytes, base64) and its id
ENCRYPTION_KEY=change-me-32-bytes-base64-random-value
ENCRYPTION_KEY_ID=k1
# ENCRYPTION_KEYS_RETIRED=   (old keys still able to decrypt: id:key,id:key)
# API-003 — origin of the back office (audience ADMIN); its invitation links lead there
# ADMIN_URL=http://localhost:3001
# SEC-028 — proxies whose X-Forwarded-For is trusted (local: the Next dev server)
# TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# PAR-080, ADM-040 — first Direction account, invited by the installation command (all three together)
# SEED_OWNER_EMAIL=
# SEED_OWNER_FIRST_NAME=
# SEED_OWNER_LAST_NAME=
# ASS-052, ENV-040 — conversational assistant (features.assistant.mode = AI). Empty: the assistant stays guided.
# AI_PROVIDER=anthropic; the key in AI_API_KEY (or ANTHROPIC_API_KEY); AI_MODEL defaults to claude-sonnet-5-5.
AI_PROVIDER=
AI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
