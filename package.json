{
  "name": "diaspora-patrimoine",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22.12 <23" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "pnpm --filter @dp/api db:start",
    "db:migrate": "pnpm --filter @dp/api db:migrate",
    "db:install": "pnpm --filter @dp/api db:install",
    "ops": "pnpm --filter @dp/api ops"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "prettier": "3.9.9"
  }
}
